---
// 編集長アバター（イラスト・SVG）。E-E-A-T改善: 「人の気配」を演出で作る。
// 実在の経歴・資格の捏造はしない方針のため、イラストのペンネームキャラクター（編集長 佐倉 透）として描く。
const { size = 64 } = Astro.props;
---
<svg width={size} height={size} viewBox="0 0 64 64" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="編集長 佐倉 透">
  <defs>
    <linearGradient id="avbg" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#1e3a8a" />
      <stop offset="1" stop-color="#2563eb" />
    </linearGradient>
    <clipPath id="avclip"><circle cx="32" cy="32" r="32" /></clipPath>
  </defs>
  <g clip-path="url(#avclip)">
    <rect width="64" height="64" fill="url(#avbg)" />
    <!-- 体（シャツ） -->
    <path d="M12 64 Q12 46 32 46 Q52 46 52 64 Z" fill="#f8fafc" />
    <path d="M26 47 L32 54 L38 47 Q32 44 26 47 Z" fill="#f97316" />
    <!-- 顔 -->
    <circle cx="32" cy="28" r="14" fill="#ffd9b8" />
    <!-- 髪 -->
    <path d="M18 26 Q18 12 32 12 Q46 12 46 26 Q46 20 40 18 Q42 22 38 21 Q34 20 30 16 Q28 21 22 22 Q19 23 18 26 Z" fill="#1f2937" />
    <!-- メガネ -->
    <rect x="21" y="25" width="9" height="7" rx="3" fill="none" stroke="#0f2744" stroke-width="1.8" />
    <rect x="34" y="25" width="9" height="7" rx="3" fill="none" stroke="#0f2744" stroke-width="1.8" />
    <line x1="30" y1="28" x2="34" y2="28" stroke="#0f2744" stroke-width="1.8" />
    <!-- 目・口 -->
    <circle cx="25.5" cy="28.5" r="1.3" fill="#1f2937" />
    <circle cx="38.5" cy="28.5" r="1.3" fill="#1f2937" />
    <path d="M28 36 Q32 39 36 36" fill="none" stroke="#c2410c" stroke-width="1.6" stroke-linecap="round" />
  </g>
</svg>

