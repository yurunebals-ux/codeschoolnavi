---
// アイキャッチのカテゴリ別イラスト（SVGの <g>）。Thumb.astro の大小2種のSVGで共用する。
// 右下（x≈456〜, y≈110〜）に置く前提の座標。strong=true のときは不透明度を上げる（小さいタイル用）。
const { cat = "解説", g1 = "#1e40af", strong = false, faint = false } = Astro.props;
const key: string = cat;
// faint: 中央組みのレイアウトでは文字と重なるので背景程度に薄くする
const op = faint ? 0.22 : strong ? 0.85 : 0.6;
---
  {key === "比較" && (
    <g transform="translate(468 118)" opacity={op}>
      <rect x="0" y="120" width="34" height="90" rx="6" fill="#ffffff" opacity="0.45" />
      <rect x="48" y="70" width="34" height="140" rx="6" fill="#ffffff" opacity={op} />
      <rect x="96" y="20" width="34" height="190" rx="6" fill="#fbbf24" />
      <circle cx="113" cy="0" r="16" fill="#fbbf24" /><path d="M105 0 l6 6 l11 -12" stroke={g1} stroke-width="4" fill="none" stroke-linecap="round" />
      <rect x="-8" y="212" width="150" height="4" rx="2" fill="#ffffff" opacity="0.5" />
    </g>
  )}
  {key === "給付金" && (
    <g transform="translate(476 150)" opacity={op}>
      {[0,1,2,3].map((i) => <g transform={`translate(0 ${150 - i * 22})`}><ellipse cx="60" cy="14" rx="60" ry="14" fill="#fde68a" /><rect x="0" y="0" width="120" height="14" fill="#fbbf24" /><ellipse cx="60" cy="0" rx="60" ry="14" fill="#fde68a" /></g>)}
      <circle cx="122" cy="20" r="34" fill="#ffffff" /><text x="122" y="30" text-anchor="middle" font-size="28" font-weight="800" fill={g1} font-family="-apple-system,'Hiragino Sans',sans-serif">%</text>
    </g>
  )}
  {key === "やめとけ" && (
    <g transform="translate(470 110)" opacity={op}>
      <path d="M70 0 L140 130 L0 130 Z" fill="#fde68a" stroke="#ffffff" stroke-width="6" stroke-linejoin="round" />
      <rect x="63" y="44" width="14" height="50" rx="7" fill={g1} /><circle cx="70" cy="112" r="8" fill={g1} />
      <rect x="20" y="160" width="100" height="6" rx="3" fill="#ffffff" opacity="0.5" /><rect x="40" y="176" width="60" height="6" rx="3" fill="#ffffff" opacity="0.35" />
    </g>
  )}
  {key === "料金" && (
    <g transform="translate(470 120)" opacity={op}>
      <rect x="0" y="0" width="130" height="180" rx="12" fill="#ffffff" opacity="0.9" />
      <rect x="18" y="22" width="94" height="10" rx="5" fill={g1} opacity="0.5" /><rect x="18" y="46" width="60" height="10" rx="5" fill={g1} opacity="0.3" />
      <text x="65" y="126" text-anchor="middle" font-size="58" font-weight="800" fill={g1} font-family="-apple-system,'Hiragino Sans',sans-serif">¥</text>
      <rect x="18" y="150" width="94" height="10" rx="5" fill={g1} opacity="0.3" />
    </g>
  )}
  {key === "評判・口コミ" && (
    <g transform="translate(456 120)" opacity={op}>
      <path d="M0 20 a20 20 0 0 1 20 -20 h120 a20 20 0 0 1 20 20 v80 a20 20 0 0 1 -20 20 h-70 l-34 30 v-30 h-16 a20 20 0 0 1 -20 -20 z" fill="#ffffff" />
      <circle cx="38" cy="60" r="7" fill={g1} /><circle cx="80" cy="60" r="7" fill={g1} /><circle cx="122" cy="60" r="7" fill={g1} />
      <circle cx="132" cy="150" r="30" fill="none" stroke="#fde68a" stroke-width="10" /><rect x="152" y="168" width="14" height="46" rx="7" transform="rotate(-45 159 191)" fill="#fde68a" />
    </g>
  )}
  {(key === "解説" || key === "学習・キャリア") && (
    <g transform="translate(456 110)" opacity={op} fill="none" stroke="#ffffff" stroke-width="8" stroke-linecap="round">
      <path d="M10 200 C 60 200, 60 120, 110 120 S 160 40, 170 30" stroke-dasharray="14 12" />
      <circle cx="10" cy="200" r="12" fill="#ffffff" stroke="none" /><circle cx="110" cy="120" r="12" fill="#ffffff" stroke="none" />
      <circle cx="170" cy="30" r="16" fill="#fde68a" stroke="none" /><path d="M170 12 v-20 h26 l-8 8 l8 8 h-26" fill="#fbbf24" stroke="none" />
    </g>
  )}
  {key === "ニュース" && (
    <g transform="translate(456 110)" opacity={op}>
      <rect x="0" y="0" width="170" height="200" rx="10" fill="#ffffff" opacity="0.92" />
      <rect x="16" y="18" width="70" height="20" rx="4" fill={g1} /><rect x="16" y="52" width="138" height="10" rx="5" fill={g1} opacity="0.5" />
      <rect x="16" y="76" width="138" height="60" rx="6" fill={g1} opacity="0.2" />
      <rect x="16" y="150" width="138" height="8" rx="4" fill={g1} opacity="0.35" /><rect x="16" y="168" width="100" height="8" rx="4" fill={g1} opacity="0.35" />
    </g>
  )}
