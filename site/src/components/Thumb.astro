---
// 記事アイキャッチの自動生成（競合分析F: 画像ゼロが「AIっぽさ」最大の原因 → 全記事にサムネイル）
// 案A: 全記事が同一構図だと「量産テンプレ」に見えるため、レイアウト3種 × 配色2種 × 装飾4種を
// タイトルのFNV-1aハッシュで決定的に選ぶ。無人運用のまま構図が散らばり、再ビルドでも同じ絵になる。
const { title = "", cat = "解説" } = Astro.props;

// カテゴリごとに4パレット。評判記事のように同カテゴリが並ぶ一覧でも色が単調にならないよう、
// 同系色の中で「明度」と「2色目の色相」を大きく振る（サムネイルサイズでも別物に見えることが条件）。
const palettes: Record<string, [string, string][]> = {
  "給付金":       [["#047857", "#0f766e"], ["#065f46", "#0d9488"], ["#14532d", "#15803d"], ["#115e59", "#0891b2"]],
  "比較":         [["#1e40af", "#4338ca"], ["#1d4ed8", "#5b21b6"], ["#0c4a6e", "#1d4ed8"], ["#312e81", "#0369a1"]],
  "評判・口コミ": [["#6d28d9", "#9d174d"], ["#7e22ce", "#be123c"], ["#4c1d95", "#7c3aed"], ["#831843", "#a21caf"]],
  "やめとけ":     [["#9f1239", "#7f1d1d"], ["#b91c1c", "#831843"], ["#7f1d1d", "#b45309"], ["#881337", "#a21caf"]],
  "解説":         [["#b45309", "#c2410c"], ["#a16207", "#ea580c"], ["#78350f", "#b45309"], ["#9a3412", "#d97706"]],
};
const labels: Record<string, string> = {
  "給付金": "給付金で安く",
  "比較": "徹底比較",
  "評判・口コミ": "評判・口コミ",
  "やめとけ": "注意点を検証",
  "解説": "解説",
};
const key = palettes[cat] ? cat : "解説";
const label = labels[key];

// タイトル → 32bit ハッシュ（FNV-1a + avalanche finalizer）。ビルドごとに同じ値になるのが要件。
// 同じハッシュのビットを切り出すと相関して偏るため、次元ごとに別シードで独立に取り直す。
const src = title || "codeschoolnavi";
const h32 = (seed: number) => {
  let h = seed >>> 0;
  for (const ch of src) {
    h = (h ^ (ch.codePointAt(0) ?? 0)) >>> 0;
    h = Math.imul(h, 16777619) >>> 0;
  }
  h ^= h >>> 15;
  h = Math.imul(h, 2246822507) >>> 0;
  h ^= h >>> 13;
  h = Math.imul(h, 3266489909) >>> 0;
  return (h ^ (h >>> 16)) >>> 0;
};
// 記事タイトルは「〇〇の評判・口コミは？特徴を解説」のように長い共通接尾辞を持つ。
// FNV-1aは下位ビットが末尾の文字だけで決まるため、下位ビットで剰余を取ると値が偏る
// （実測: 評判記事7本すべてが同じ2パレットに落ちた）。上位ビットへシフトしてから剰余を取る。
const pick = (seed: number, n: number) => (h32(seed) >>> 11) % n;
const hv = h32(2166136261);
const layout = pick(2166136261, 3);
const variant = pick(0x9e3779b1, palettes[key].length);
const motif = pick(0x85ebca6b, 4);
const angle = pick(0xc2b2ae35, 3);

const [g1, g2] = palettes[key][variant];
// inline SVGを1ページに複数置くのでグラデーションIDは記事ごとに一意にする（id衝突で全部同色になる）
const uid = "t" + hv.toString(36) + layout;
const dir = [
  { x1: "0", y1: "0", x2: "1", y2: "1" },
  { x1: "0", y1: "1", x2: "1", y2: "0" },
  { x1: "0", y1: "0", x2: "1", y2: "0" },
][angle];

// レイアウトごとの文字組み
const cfg = [
  { N: 10, fs: 38, tx: 44, anchor: "start",  cy: 198, chipX: 44,  chipY: 36, brand: "left"  },
  { N: 13, fs: 40, tx: 320, anchor: "middle", cy: 202, chipX: 320, chipY: 48, brand: "right" },
  { N: 12, fs: 36, tx: 58, anchor: "start",  cy: 192, chipX: 36,  chipY: 36, brand: "left"  },
][layout];

const clean = title.replace(/【[^】]*】/g, "").replace(/[｜|].*$/, "").replace(/\s+/g, " ").trim();

// 「DMM WEBCAM / Pの評判」のような欧文語の途中改行は素人っぽく見えるので、
// 欧文はひとかたまり（トークン）として扱い、和文は1文字単位で折る。
// 幅は全角1.0／半角0.6で数え、cfg.N（全角換算の1行あたり文字数）に収める。
const isWide = (c: string) => /[　-ヿ぀-ゟ一-鿿㐀-䶿！-｠￠-￦]/.test(c);
const w = (s: string) => [...s].reduce((n, c) => n + (isWide(c) ? 1 : 0.6), 0);

const tokens: string[] = [];
let buf = "";
for (const ch of clean) {
  if (ch === " ") { if (buf) { tokens.push(buf); buf = ""; } continue; }
  if (isWide(ch)) { if (buf) { tokens.push(buf); buf = ""; } tokens.push(ch); }
  else buf += ch;
}
if (buf) tokens.push(buf);

// 1トークンで1行を超える欧文（長い英語名）は、はみ出させずに分割する
const fitted: string[] = [];
for (const t of tokens) {
  if (w(t) <= cfg.N || isWide(t)) { fitted.push(t); continue; }
  const per = Math.max(1, Math.floor(cfg.N / 0.6));
  for (let i = 0; i < t.length; i += per) fitted.push(t.slice(i, i + per));
}

// 行頭禁則。中黒や句読点・小書き仮名・長音符が行頭に来ると和文組版として素人臭くなるので、
// 直前の行に「追い込む」（上限幅を1文字だけ超えることを許す）。
const ngStart = /^[、。，．・：；？！」』）］｝〉》”’ー々ぁぃぅぇぉっゃゅょゎァィゥェォッャュョヮヵヶ〜…]/;
const wrap = (cap: number) => {
  const out: string[] = [];
  let cur = "";
  for (const t of fitted) {
    const sep = cur && !isWide(t) && !isWide(cur.slice(-1)) ? " " : "";
    const next = cur + sep + t;
    if (cur && w(next) > cap && !ngStart.test(t)) { out.push(cur); cur = t; } else cur = next;
  }
  if (cur) out.push(cur);
  return out;
};
// 貪欲な折り返しだと最終行に1文字だけ残る「泣き別れ」が起きる
// （実測: 「DMM WEBCAMPの評判／・口コミは？特徴を解／説」）。
// 行数を増やさない範囲で1行の上限幅を詰めていき、行長が均等になる組を採用する。
let lines = wrap(cfg.N);
if (lines.length > 1) {
  const total = fitted.reduce((n, t) => n + w(t), 0);
  for (let cap = Math.ceil(total / lines.length); cap < cfg.N; cap++) {
    const cand = wrap(cap);
    if (cand.length === lines.length) { lines = cand; break; }
  }
}
if (lines.length > 3) {
  lines.length = 3;
  while (lines[2] && w(lines[2]) > cfg.N - 1) lines[2] = lines[2].slice(0, -1);
  lines[2] += "…";
}

const startY = cfg.cy - ((lines.length - 1) * (cfg.fs + 10)) / 2;
const chipW = label.length * 15 + 34;
const chipX = cfg.anchor === "middle" ? cfg.chipX - chipW / 2 : cfg.chipX;
const glyph = key === "給付金" ? "¥" : key === "評判・口コミ" ? "★" : key === "やめとけ" ? "!" : "</>";
// 装飾の濃淡もハッシュで少し振る
const dots = [0, 1, 2, 3, 4].flatMap((r) => [0, 1, 2, 3].map((c) => ({ r, c })));
---
<svg viewBox="0 0 640 360" xmlns="http://www.w3.org/2000/svg" role="img" aria-label={title} preserveAspectRatio="xMidYMid slice">
  <defs>
    <linearGradient id={uid} x1={dir.x1} y1={dir.y1} x2={dir.x2} y2={dir.y2}>
      <stop offset="0" stop-color={g1} />
      <stop offset="1" stop-color={g2} />
    </linearGradient>
  </defs>
  <rect width="640" height="360" fill={`url(#${uid})`} />

  <!-- 装飾モチーフ（4種） -->
  {motif === 0 && (
    <g>
      <text x="600" y="332" text-anchor="end" font-family="ui-monospace,monospace" font-size="130" font-weight="800" fill="#ffffff" opacity="0.10">{glyph}</text>
      <circle cx="52" cy="322" r="90" fill="#ffffff" opacity="0.06" />
      <circle cx="612" cy="28" r="56" fill="#ffffff" opacity="0.08" />
    </g>
  )}
  {motif === 1 && (
    <g opacity="0.16">
      {dots.map((d) => <circle cx={470 + d.c * 42} cy={70 + d.r * 42} r="7" fill="#ffffff" />)}
      <rect x="0" y="0" width="640" height="360" fill="none" />
    </g>
  )}
  {motif === 2 && (
    <g fill="none" stroke="#ffffff" stroke-width="14">
      <circle cx="626" cy="352" r="70" opacity="0.10" />
      <circle cx="626" cy="352" r="128" opacity="0.08" />
      <circle cx="626" cy="352" r="186" opacity="0.06" />
    </g>
  )}
  {motif === 3 && (
    <g opacity="0.11" fill="#ffffff">
      {[0, 1, 2, 3, 4, 5].map((i) => <rect x={330 + i * 56} y="-60" width="26" height="480" transform={`rotate(18 ${330 + i * 56} 180)`} />)}
    </g>
  )}

  <!-- レイアウト固有の面構成 -->
  {layout === 0 && (
    <g>
      <rect x="392" y="0" width="248" height="360" fill="#0b1220" opacity="0.18" />
      <rect x="0" y="0" width="13" height="360" fill="#f97316" />
    </g>
  )}
  {layout === 1 && (
    <g>
      <rect x="0" y="112" width="640" height="176" fill="#0b1220" opacity="0.20" />
      <rect x="0" y="348" width="640" height="12" fill="#f97316" />
    </g>
  )}
  {layout === 2 && (
    <g>
      <rect x="36" y={startY - 30} width="6" height={lines.length * (cfg.fs + 10) + 6} fill="#f97316" />
      <rect x="0" y="0" width="640" height="8" fill="#f97316" opacity="0.85" />
      <line x1="58" y1={startY + lines.length * (cfg.fs + 10) - 2} x2="360" y2={startY + lines.length * (cfg.fs + 10) - 2} stroke="#ffffff" stroke-width="2" opacity="0.4" />
    </g>
  )}

  <!-- カテゴリチップ -->
  <rect x={chipX} y={cfg.chipY} rx="15" width={chipW} height="30" fill="#ffffff" opacity="0.94" />
  <text x={cfg.anchor === "middle" ? cfg.chipX : chipX + 17} y={cfg.chipY + 21} text-anchor={cfg.anchor === "middle" ? "middle" : "start"} font-family="-apple-system,'Hiragino Sans','Noto Sans JP',sans-serif" font-size="15" font-weight="700" fill={g1}>{label}</text>

  <!-- タイトル -->
  {lines.map((ln, i) => (
    <text x={cfg.tx} y={startY + i * (cfg.fs + 10)} text-anchor={cfg.anchor} font-family="-apple-system,'Hiragino Sans','Noto Sans JP',sans-serif" font-size={cfg.fs} font-weight="800" fill="#ffffff" letter-spacing="1">{ln}</text>
  ))}

  <!-- ブランドロックアップ -->
  {cfg.brand === "left" ? (
    <g>
      <rect x="44" y="300" rx="6" width="26" height="26" fill="#ffffff" opacity="0.92" />
      <text x="49" y="318" font-family="ui-monospace,monospace" font-size="11" font-weight="800" fill={g1}>&lt;/&gt;</text>
      <text x="78" y="318" font-family="-apple-system,'Hiragino Sans','Noto Sans JP',sans-serif" font-size="15" font-weight="700" fill="#ffffff" opacity="0.92">コードスクールナビ</text>
    </g>
  ) : (
    <g>
      <text x="566" y="318" text-anchor="end" font-family="-apple-system,'Hiragino Sans','Noto Sans JP',sans-serif" font-size="15" font-weight="700" fill="#ffffff" opacity="0.92">コードスクールナビ</text>
      <rect x="574" y="300" rx="6" width="26" height="26" fill="#ffffff" opacity="0.92" />
      <text x="579" y="318" font-family="ui-monospace,monospace" font-size="11" font-weight="800" fill={g1}>&lt;/&gt;</text>
    </g>
  )}
</svg>
