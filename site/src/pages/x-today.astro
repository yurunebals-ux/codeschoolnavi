---
// X の「ワンタップ投稿」ページ（2026-09-26 オーナー決定。X API の従量課金を使わず、手動で1日1回投稿する）
// 開くと、その日の1本の投稿文が入った X の投稿画面（intent）へすぐ移る。オーナーは「ポスト」を押すだけ。
// ?list を付けて開くと移動せず、候補（直近の記事）から選べる。
// 検索には出さない（noindex・サイトマップ除外）。ビルドのたびに選び直すので、その日の新着が入る。
import { getCollection } from "astro:content";
// 投稿に添える1〜2行のひとこと（2026-09-26 オーナー指定）:
//   1) ニュース記事は「スレの流れ」の2番目（最初の名無しさん。はてなブックマーク等の実際の反応）を 名無しさん「…」 として引用
//   2) スレが無い記事（読み物など）は「編集部の井戸端会議」から1文を 編集部「…」 として引用
//   3) どちらも無ければ AI が作ったひとこと（site/src/data/x-comments.json、任意）→ 説明文
import xc from "../data/x-comments.json";

// スレの流れの最初の名無しさん（番号2）。中傷・下品な語・URL・「後で読む」系は飛ばして次を使う。長ければ文の区切りで60字以内に
const NG = /死ね|殺|キチガイ|ガイジ|池沼|クズ|バカ|馬鹿|アホ|キモ|ゴミ|カス|糞|クソ|ブス|デブ|ハゲ|まんこ|ちんこ|セックス|レイプ|後で読|あとで読|http|www\.|\[|\]/;
function pickThread(body: string): string | null {
  const sec = body.split(/\n## スレの流れ\s*\n/)[1];
  if (!sec) return null;
  const part = sec.split(/\n## /)[0];
  const items = [...part.matchAll(/^\s*(\d+)\.\s*名無しさん「([\s\S]*?)」\s*$/gm)].map((m) => m[2].replace(/\s+/g, " ").trim());
  const t = items.find((x) => [...x].length >= 8 && !NG.test(x));
  if (!t) return null;
  if ([...t].length <= 60) return t;
  let out = "";
  for (const seg of t.split(/(?<=[。！？!?])/)) { if ([...(out + seg)].length > 60) break; out += seg; }
  return out || [...t].slice(0, 59).join("") + "…";
}

// 井戸端会議のタケシ（解説役）・佐倉（まとめ役）の発言から、単独で読んで意味が通り、要点になっている1文を選ぶ
function pickQuote(body: string): string | null {
  const sec = body.split(/\n## 編集部の井戸端会議\s*\n/)[1];
  if (!sec) return null;
  const part = sec.split(/\n## /)[0];
  const lines = [...part.matchAll(/\*\*(佐倉|タケシ|ミナ)\*\*「([\s\S]*?)」\s*$/gm)].map((m, i) => ({ who: m[1], text: m[2].trim(), i }));
  const n = lines.length;
  let best: { s: string; sc: number } | null = null;
  for (const l of lines) {
    if (l.who === "ミナ") continue; // 聞き役（質問）は引用しない
    for (let s of l.text.split(/(?<=。)/).map((x) => x.trim()).filter(Boolean)) {
      s = s.replace(/^(それに|逆に|ただし|でも|だから|なので|まあ|うん|あと|実際)、?/, "");
      const len = [...s].length;
      if (len < 14 || len > 58) continue;
      if (/^(つまり|そうだね|そう|うん|そういう見方|こうした|こういう|この|その|それ|これ|あれ|そこ|ここ)/.test(s)) continue; // 前の発言がないと意味が通らない
      if (/学ぶ人は|今月中に|今週中に|そうでない人は/.test(s)) continue; // 佐倉の定型の締め
      if (/[「」『』]|http/.test(s)) continue;
      let sc = 0;
      if (/リスク|可能性|限らない|万能|注意|鍵|ポイント|見落と|本質|むしろ|だけでは|ではない|が大事|重要|差が|分かれ/.test(s)) sc += 3;
      if (/が、|けど|ただ|一方/.test(s)) sc += 1;
      sc += (l.i / n) * 2; // 後半ほど結論に近い
      if ((s.match(/\d/g) || []).length >= 3) sc -= 2;
      if (l.who === "佐倉") sc += 0.5;
      if (!best || sc > best.sc) best = { s, sc };
    }
  }
  return best ? best.s : null;
}
const SITE = (import.meta.env.SITE || "https://codeschoolnavi.com").replace(/\/$/, "");
const jst = (t: number) => new Date(t + 9 * 3600000).toISOString().slice(0, 10);
const today = jst(Date.now());
const yday = jst(Date.now() - 86400000);
const all = (await getCollection("blog", ({ data }) => !data.draft)).sort((a, b) => b.data.pubDate.localeCompare(a.data.pubDate));
const recent = all.filter((p) => p.data.pubDate >= yday);
const pool = (recent.length ? recent : all.slice(0, 5));
// 選ぶ順: 今日の記事 → 読み物（学び・キャリア）→ 反応の多いニュース → 新しい順。スクール比較（広告記事）は後回し
const rank = (p: any) => (p.data.pubDate === today ? 10000 : 0) + (p.data.topic ? 3000 : p.data.news ? 2000 : 0) + Math.min(p.data.reactions ?? 0, 999);
const cands = [...pool].sort((a, b) => rank(b) - rank(a) || b.data.pubDate.localeCompare(a.data.pubDate)).slice(0, 6);
const cut = (s: string, n: number) => ([...s].length > n ? [...s].slice(0, n - 1).join("") + "…" : s);
const items = cands.map((p) => {
  const label = p.data.news ? "【AIニュースまとめ】" : p.data.topic ? "【学び・キャリア】" : "【スクール比較】";
  const tags = p.data.news ? ["AIニュース", "生成AI"] : ["プログラミング学習", "リスキリング"];
  // X は日本語を2文字として数える（上限280）。見出し＋説明を約110字に収め、URL（23）とハッシュタグの余裕を残す
  const head = `${label}${p.data.title}`;
  const thread = pickThread(p.body || "");
  const quote = thread ? null : pickQuote(p.body || "");
  const comment = thread ? `名無しさん「${thread}」` : quote ? `編集部「${quote}」` : ((xc as any)[p.slug]?.comment as string | undefined);
  const text = comment
    ? `${comment}\n\n${head}`
    : `${head}\n\n${cut(p.data.description, Math.max(0, 105 - [...head].length))}`.trim();
  const url = `${SITE}/blog/${p.slug}/`;
  const intent = `https://x.com/intent/post?text=${encodeURIComponent(text)}&url=${encodeURIComponent(url)}&hashtags=${encodeURIComponent(tags.join(","))}`;
  return { slug: p.slug, date: p.data.pubDate, title: p.data.title, label, text, url, tags, intent, hasComment: !!comment, fromQuote: !!quote, fromThread: !!thread };
});
const first = items[0];
---
<!doctype html>
<html lang="ja">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex,nofollow" />
  <title>今日のX投稿｜コードスクールナビ</title>
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <meta name="apple-mobile-web-app-title" content="X投稿" />
  <style>
    body{margin:0;font-family:-apple-system,"Hiragino Sans","Noto Sans JP",sans-serif;background:#fff;color:#0f172a;background-image:linear-gradient(rgba(8,145,178,.06) 1px,transparent 1px),linear-gradient(90deg,rgba(8,145,178,.06) 1px,transparent 1px);background-size:32px 32px}
    main{max-width:640px;margin:0 auto;padding:24px 16px 48px}
    .tag{font-family:ui-monospace,Menlo,monospace;font-size:12px;color:#0e7490;letter-spacing:.1em}
    h1{font-size:22px;margin:6px 0 4px}
    .note{font-size:13px;color:#64748b;margin:0 0 18px}
    .card{background:#fff;border:1px solid #dbe7ef;border-radius:6px;padding:14px 16px;margin:0 0 12px}
    .card.top{border:2px solid #06b6d4;box-shadow:0 0 18px rgba(6,182,212,.2)}
    .meta{font-size:12px;color:#64748b;font-family:ui-monospace,Menlo,monospace}
    .txt{white-space:pre-wrap;font-size:14.5px;line-height:1.7;margin:6px 0 4px}
    .u{font-size:12.5px;color:#0891b2;word-break:break-all}
    .h{font-size:12.5px;color:#a21caf}
    a.btn{display:inline-block;margin-top:10px;background:#0f172a;color:#fff;text-decoration:none;font-weight:800;padding:10px 20px;border-radius:999px}
    .card.top a.btn{background:#d946ef;box-shadow:0 0 12px rgba(217,70,239,.4)}
    .go{font-size:13px;color:#0e7490;margin:0 0 14px}
  </style>
</head>
<body>
  <main>
    <div class="tag">// X ONE-TAP POST</div>
    <h1>今日のX投稿</h1>
    <p class="note">ボタンを押すと、投稿文が入ったXの投稿画面が開きます。あとは「ポスト」を押すだけです（{today} 時点の候補）。</p>
    {first ? (
      <p class="go" id="go">Xの投稿画面を開いています…　開かないときは下のボタンを押してください。</p>
    ) : (
      <p class="go">候補の記事がありません。</p>
    )}
    {items.map((it, i) => (
      <div class={i === 0 ? "card top" : "card"}>
        <div class="meta">{i === 0 ? "今日のおすすめ ・ " : ""}{it.date} ・ {it.slug}{it.fromThread ? " ・ スレの2番目から引用" : it.fromQuote ? " ・ 井戸端会議から引用" : it.hasComment ? " ・ AIのひとこと" : " ・ ひとことなし"}</div>
        <div class="txt">{it.text}</div>
        <div class="u">{it.url}</div>
        <div class="h">{it.tags.map((t) => `#${t}`).join(" ")}</div>
        <a class="btn" href={it.intent} target="_top">{i === 0 ? "この内容でXに投稿する" : "こちらを投稿する"}</a>
      </div>
    ))}
  </main>
  {first && (
    <script is:inline define:vars={{ intent: first.intent }}>
      // パソコン: ?list が付いていなければ、今日のおすすめの投稿画面へすぐ移る
      // iPhone・Android: 自動では移らない。ボタンを押したときだけ X アプリが開く（ページが勝手に移るとアプリではなくブラウザ版の X が開き、ログインを求められるため）
      var g = document.getElementById("go");
      var mobile = /iPhone|iPad|iPod|Android/i.test(navigator.userAgent) || (navigator.platform === "MacIntel" && navigator.maxTouchPoints > 1);
      if (/[?&]list\b/.test(location.search)) { if (g) g.textContent = "候補から選んでください。"; }
      else if (mobile) { if (g) g.textContent = "ピンクのボタンを押すと、投稿文が入った X アプリが開きます。"; }
      else { setTimeout(function () { location.href = intent; }, 400); }
    </script>
  )}
</body>
</html>
