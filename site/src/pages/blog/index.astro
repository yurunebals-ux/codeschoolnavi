---
// 記事一覧（アーカイブ）。トップページは10本で止めて、残りはここで探す。
// カテゴリごとにまとめ、上のチップで飛べるようにする（JSなしで動く）。
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import Thumb from "../../components/Thumb.astro";
import { catOf, type Cat } from "../../lib/cat";
import { shotsFor } from "../../lib/school";

const posts = (await getCollection("blog", ({ data }) => !data.draft))
  .sort((a, b) => +new Date(b.data.pubDate) - +new Date(a.data.pubDate));
const order: Cat[] = ["ニュース", "評判・口コミ", "料金", "注意点", "比較", "給付金", "学習・キャリア", "解説"]; // ニュースを先頭に（2026-09-18）
const groups = order
  .map((c) => ({ cat: c, items: posts.filter((p) => catOf(p.data.title, p.data) === c) }))
  .filter((g) => g.items.length);
const anchor = (c: string) => "cat-" + order.indexOf(c as Cat);
const blurb: Record<string, string> = {
  "評判・口コミ": "1校ずつ、公式情報と編集部の基準で「合う人・合わない人」を判定した記事。",
  "料金": "受講料は高いのか。同カテゴリの他校と並べ、コース別の中身と給付金の適用を検証した記事。",
  "比較": "目的別・カテゴリ別に複数校を同じ軸で並べた記事。",
  "注意点": "申し込む前に知っておきたい条件や向き不向きを、事実で検証した記事。",
  "給付金": "教育訓練給付金の対象校と、いくら戻るかを区分ごとに整理した記事。",
  "学習・キャリア": "スクール比較の外側。学ぶ順番・独学との分かれ目・AI時代のキャリアの話。",
  "ニュース": "AI・プログラミング教育・リスキリング関連のニュースを、スクール選びの視点で短く解説。",
  "解説": "制度や用語、料金の読み方など。",
};
---
<Base title="記事一覧" description={`コードスクールナビの全記事（${posts.length}本）。評判・比較・注意点・給付金・学習とキャリア・ニュース解説をカテゴリ別に。`}>
  <h1>記事一覧 <small class="cnt">全{posts.length}本 ・ 毎日更新</small></h1>
  <nav class="catnav" aria-label="カテゴリ">
    {groups.map((g) => <a href={`#${anchor(g.cat)}`} data-cat={g.cat}><span class="chip">{g.cat}</span><small>{g.items.length}</small></a>)}
  </nav>

  {groups.map((g) => (
    <section class="arch" id={anchor(g.cat)} data-cat={g.cat}>
      <div class="sec-head" style="--sec-c:var(--cc)"><h2>{g.cat}</h2><span class="note">{blurb[g.cat]}</span></div>
      <ul class="cards">
        {g.items.map((p, i) => (
          <li class="reveal" style={`--i:${i % 2}`}>
            <a class="card row" data-cat={g.cat} href={`/blog/${p.slug}/`}>
              <span class="cthumb"><Thumb title={p.data.title} cat={g.cat} shots={shotsFor(p.slug)} compact /></span>
              <span class="cbody">
                <span class="chip">{g.cat}</span>
                <span class="t">{p.data.title}</span>
                <span class="d">{p.data.updatedDate ?? p.data.pubDate} 更新</span>
              </span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  ))}
</Base>

<style is:global>
  .cnt{font-size:13px;font-weight:600;color:var(--mut);margin-left:8px}
  .catnav{display:flex;gap:8px;flex-wrap:wrap;margin:6px 0 30px}
  .catnav a{display:inline-flex;align-items:center;gap:6px;text-decoration:none;border:1px solid var(--bd);border-radius:999px;padding:5px 12px 5px 6px;background:#fff;box-shadow:var(--shadow);transition:transform .18s,box-shadow .18s}
  .catnav a:hover{transform:translateY(-2px);box-shadow:var(--shadow-hi)}
  .catnav .chip{background:var(--cbg);color:var(--cfg);border-radius:999px;padding:2px 10px;font-size:12.5px;font-weight:700}
  .catnav small{color:var(--mut);font-weight:700}
  .arch{margin:0 0 40px;scroll-margin-top:72px}
  .arch .sec-head .note{margin-left:0;flex-basis:100%}
</style>
