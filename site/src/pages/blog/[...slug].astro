---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import Thumb from "../../components/Thumb.astro";
import Avatar from "../../components/Avatar.astro";
import FigPrice from "../../components/FigPrice.astro";
import FigMap from "../../components/FigMap.astro";
import FigKyufu from "../../components/FigKyufu.astro";
import Cta from "../../components/Cta.astro";
import Comments from "../../components/Comments.astro";
import Poll from "../../components/Poll.astro";
import Shot from "../../components/Shot.astro";
import pricewatch from "../../data/pricewatch.json";
import { catOf } from "../../lib/cat";
import { schoolFromSlug, shotsFor } from "../../lib/school";
import offersFile from "../../data/offers.json";

export async function getStaticPaths() {
  const posts = await getCollection("blog", ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { slug: post.slug }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await post.render();
const d = post.data;
const cat = catOf(d.title, d);

// 独自データ：この記事のスクールに公式料金の観測記録があれば「監視ログ」を表示。
// slug 規約 hyoban-<id> と pricewatch.json のキーを対応させる。
// 【2026-09-11 修正】以前は hyoban- だけを見ていたため、ryokin-（料金）・yametoke-（やめとけ）・
// hikaku-（比較）の記事は主題スクールが判定されず、CTAも料金監視も公式スクショも出ていなかった。
// 8月に提携済み校の料金/やめとけ記事を優先して公開したのに、その23本にアフィリンクが1本も無かった。
// slug 規約: <template>-<toolId> ／ hikaku-<a>-<b>（比較は提携済み側を主題にする）。
// slug → スクールの判定は site/src/lib/school.ts（一覧のアイキャッチと共用）
const watchId = schoolFromSlug(post.slug);
const eyeShots = shotsFor(post.slug);
const watch = watchId ? (pricewatch as any).schools?.[watchId] : null;
const watchTool = watchId ? (offersFile as any).offers?.[watchId] ?? null : null;
const hasWatch = !!(watch && watch.lastChecked);
const changeDates: string[] = hasWatch ? watch.observations.map((o: any) => o.date).slice(-5).reverse() : [];

// 記事内の図解。slug/タイトルから対象スクールを特定し、schools.json のデータで作図する。
// 図はいったん本文の後ろに出力し、直後のインラインスクリプトで h2 の位置へ移動させる
// （Astro のマークダウンは分割できないため。JSが無効でも図は本文末に残るので情報は失われない）。
const ALIAS: Record<string, string> = {
  techacademy: "TechAcademy",
  dmmwebcamp: "SHIFT TERAS CAMPUS",
  techcamp: "テックキャンプ",
  codecamp: "CodeCamp",
  runteq: "RUNTEQ",
  kikagaku: "キカガク",
};
const school = watchId && ALIAS[watchId] ? ALIAS[watchId] : null;
const isKyufu = cat === "給付金";

// 申し込み導線。記事の主題スクールに紐づける。
// 給付金ハブのように1校に紐づかない記事は offers.json の picks で指名する
// （給付金対象のうち提携済みのものが自動で選ばれる。ハードコードしない）。
const ctaId = watchId ?? (isKyufu ? (offersFile as any).picks?.kyufukin ?? null : null);
// 料金監視ボックスの「公式サイト」は記事の一番上にある唯一の外部リンクなのに、
// これまで素の公式URLだったので1円にもなっていなかった。提携済みならここも
// アフィリンクにする（未提携なら従来どおり公式URL。PR表示も出さない）。
const watchOffer = watchId ? (offersFile as any).offers?.[watchId] ?? null : null;
// 図解とCTAの差し込み位置。CTAは図解より後ろ＝読者が判断材料を見たあとに置く。
const figMapAfter = isKyufu ? 4 : 3;
const ctaAfter = figMapAfter + 1;
---
{/* 検索結果の <title> だけに「【2026年9月】」を付ける（H1 は変えない）。料金は毎日自動照合しているので月の表示は事実。
    Search Console（2026-09-17）で 20〜30位の評判・料金クエリの CTR が 0% だった対策。ニュース・トピックは付けない */}
<Base title={d.news || d.topic ? d.title : `${d.title}【${new Date().getFullYear()}年${new Date().getMonth() + 1}月】`} description={d.description} article={d} ogImage={eyeShots[0]?.og}>
  <article>
    <h1>{d.title}</h1>
    <div class="meta">
      <span class="badge">{d.news ? "編集部コラム" : d.topic ? "学習・キャリア" : "✓ 3軸で検証済み"}</span>
      <span>更新日: {d.updatedDate || d.pubDate}</span>
      <span>執筆: {d.author}（編集長 佐倉 透）</span>
    </div>
    <div class="eyecatch"><Thumb title={d.title} cat={cat} shots={eyeShots} eager={true} /></div>
    {eyeShots.length > 0 && watchTool && (
      <p class="shot-credit">出典：<a href={watchTool.official ?? watchTool.href} target="_blank" rel="nofollow noopener">{watchTool.name}公式サイト</a>（{eyeShots[0].takenAt.slice(0, 4)}年{Number(eyeShots[0].takenAt.slice(5, 7))}月時点の表示）。画像は当サイトが自動取得したもので、最新の画面とは異なることがあります。</p>
    )}
    <nav class="toc" id="toc" hidden>
      <div class="toc-title">📑 この記事の目次</div>
      <ol id="toc-list"></ol>
    </nav>
    {watchTool && eyeShots.length === 0 && <Shot id={watchId} name={watchTool.name} official={watchTool.official} />}
    {hasWatch && (
      <aside class="pricelog">
        <div class="pl-title">🔎 料金表示の自動監視（当サイト独自）</div>
        <p class="pl-body">
          {watch.name}の公式サイトの料金表示を毎日自動で確認しています。
          <b>最終確認日: {watch.lastChecked}</b>
          {changeDates.length > 0 && <span> ／ 表示の変化を検出した日: {changeDates.join("、")}</span>}
        </p>
        <p class="pl-note">※価格そのものは必ず<a class="pl-official" href={watch.url} target="_blank" rel="nofollow noopener">公式サイト</a>でご確認ください。本ログは記事の料金情報が古くなっていないかを確認するための当サイト独自の仕組みです。</p>
      </aside>
    )}
    <Content />

    {/* ニュースコラムにスクールの料金図解やCTAを挟まない（2026-09-11 本番で出典の直下に料金グラフが出ていた） */}
    <div id="figbank">
      {!d.news && <div class="figslot" data-after="1"><FigPrice highlight={school} /></div>}
      {isKyufu && <div class="figslot" data-after="2"><FigKyufu /></div>}
      {!d.news && <div class="figslot" data-after={figMapAfter}><FigMap highlight={school} /></div>}
      {/* 記事途中の申込ボックスは外した。申込ボタンは記事末の1つだけ（オーナー方針 2026-09-23「アフィリエイトは前面に出さない」） */}
    </div>
    <script is:inline>
      // 「編集部の井戸端会議」を吹き出しの会話に、「3行で言うと」を要約カードに、「スレの流れ」をまとめサイト風のレスにする。
      (function () {
        var art = document.currentScript.closest("article");
        if (!art) return;
        var wrap = function (h2, cls) {
          var box = document.createElement("div"); box.className = cls;
          h2.parentNode.insertBefore(box, h2);
          var el = h2;
          // 次の ## か、先に包んだ箱（kaigi / tldr / reactions）に当たるまで
          while (el && !(el !== h2 && (/^H2$/.test(el.tagName) || /\b(kaigi|tldr|reactions)\b/.test(el.className || "")))) { var next = el.nextElementSibling; box.appendChild(el); el = next; }
          return box;
        };
        Array.prototype.slice.call(art.querySelectorAll("h2")).forEach(function (h) {
          var t = h.textContent;
          if (/井戸端会議/.test(t)) {
            var box = wrap(h, "kaigi");
            Array.prototype.slice.call(box.querySelectorAll("p")).forEach(function (p) {
              var st = p.querySelector("strong");
              if (!st || st !== p.firstChild) return;
              var who = st.textContent.trim();
              p.className = "say say-" + ({ "佐倉": "sakura", "ミナ": "mina", "タケシ": "takeshi" }[who] || "x");
              var text = p.textContent.slice(who.length).replace(/^「|」$/g, "");
              p.innerHTML = '<span class="av">' + who.slice(0, 1) + '</span><span class="bub"><b>' + who + '</b>' + text.replace(/</g, "&lt;") + '</span>';
            });
          } else if (/3行で言うと/.test(t)) {
            wrap(h, "tldr");
          }
        });
        // スレの流れ（h2 = まとめ風のニュース記事、h3 = 旧形式）。1がニュースデスク、以降は実際のコメント
        Array.prototype.slice.call(art.querySelectorAll("h2, h3")).forEach(function (h) {
          if (!/スレの流れ/.test(h.textContent)) return;
          var box = h.tagName === "H2" ? wrap(h, "reactions thread-box") : null;
          var ol = (box || h.parentNode).querySelector("ol"); if (!ol) return;
          ol.className = "thread";
          Array.prototype.slice.call(ol.children).forEach(function (li, i) {
            var raw = li.textContent.trim();
            var m = raw.match(/^(ニュースデスク|名無しさん（海外）|名無しさん)\s*「?([\s\S]*?)」?$/);
            var who = m ? m[1] : "名無しさん", txt = m ? m[2] : raw;
            var cls = who === "ニュースデスク" ? "desk" : /海外/.test(who) ? "abroad" : "";
            li.className = cls;
            li.innerHTML = '<span class="no">' + (i + 1) + '</span><span class="nm">' + who + '</span><span class="tx">' + txt.replace(/</g, "&lt;") + '</span>';
          });
        });
      })();
    </script>
    <script is:inline>
      // ニュース記事の「ネットの反応」節をまとめサイト風の箱にする（見出しから次の ## まで）。
      (function () {
        var art = document.currentScript.closest("article");
        if (!art) return;
        var h2 = Array.prototype.slice.call(art.querySelectorAll("h2")).find(function (h) { return /ネットの反応/.test(h.textContent); });
        if (!h2) return;
        var box = document.createElement("div"); box.className = "reactions";
        h2.parentNode.insertBefore(box, h2);
        var el = h2;
        while (el && !(el !== h2 && /^H2$/.test(el.tagName))) { var next = el.nextElementSibling; box.appendChild(el); el = next; }
      })();
    </script>
    <script is:inline>
      // 図解を本文の見出し位置へ移す。パース中に実行されるので、下に一瞬見えることはない。
      (function () {
        var art = document.currentScript.closest("article");
        if (!art) return;
        var bank = art.querySelector("#figbank");
        if (!bank) return;
        // 図解の差し込み先は「本文の節」だけ。要約・データ表・会話・反応・FAQ・出典の節は数えない（2026-09-17）
        var h2s = Array.prototype.slice.call(art.querySelectorAll("h2")).filter(function (h) {
          return !/3行で言うと|基本データ|井戸端会議|ネットの反応|よくある質問|^出典|あわせて読みたい|比較一覧/.test(h.textContent);
        });
        var slots = Array.prototype.slice.call(bank.querySelectorAll(".figslot"));
        slots.forEach(function (slot) {
          var n = parseInt(slot.getAttribute("data-after"), 10);
          if (!h2s.length) return;
          var h2 = h2s[Math.min(n, h2s.length) - 1];
          if (!h2) return;
          // 見出し直後の最初の段落のあとに置く（見出しと本文の間に挟まないため）
          var anchor = h2, el = h2.nextElementSibling;
          while (el && !/^H[123]$/.test(el.tagName)) {
            if (el.tagName === "P") { anchor = el; break; }
            el = el.nextElementSibling;
          }
          anchor.parentNode.insertBefore(slot, anchor.nextSibling);
        });
        bank.remove();
      })();
    </script>

    <Cta id={ctaId} heading="この記事を読んで、次に動くなら" />

    {/* 匿名コメント欄（2026-09-26 オーナー「コメントを残せる掲示板のような機能」） */}
    {d.news && <Poll page={post.slug} q={d.poll?.q} a={d.poll?.a} b={d.poll?.b} />}
    <Comments page={post.slug} placeholder={d.news ? "このニュースへの感想・反論・現場の話など（500文字まで）" : "この記事への感想・疑問・受講した人の体験など（500文字まで）"} />

    <section class="authorbox">
      <span class="ab-av"><Avatar size={52} /></span>
      <div>
        <b>執筆・検証：コードスクールナビ編集部　編集長 佐倉 透（さくら とおる）</b>
        <p>各スクールの<b>公式サイト・料金表・教育訓練給付の指定講座情報</b>をもとに「教育の質・サポート・実績」の3軸で比較しています。掲載後も公式サイトの料金表示を毎日自動照合し、変化を検出した場合は記事を見直します。広告の有無は評価・掲載順に影響しません。誤りのご指摘は<a href="/about/">運営者情報</a>から（確認のうえ訂正します）。</p>
      </div>
    </section>
  </article>
  <script is:inline>
    // 目次を h2 から自動生成（CVR: 迷子防止と要点への直行導線）
    const hs = Array.from(document.querySelectorAll("main article h2"))
      .filter((h) => !/あわせて読みたい|関連記事/.test(h.textContent));
    if (hs.length >= 2) {
      const list = document.getElementById("toc-list");
      hs.forEach((h, i) => {
        if (!h.id) h.id = "sec-" + (i + 1);
        const li = document.createElement("li");
        const a = document.createElement("a");
        a.href = "#" + h.id;
        a.textContent = h.textContent.replace(/^[0-9]+\.\s*/, "");
        li.appendChild(a);
        list.appendChild(li);
      });
      document.getElementById("toc").hidden = false;
    }
  </script>
  <style is:global>
    /* 3行で言うと（要約カード） */
    .tldr{background:#f5feff;border:1px solid #a5f3fc;border-radius:4px;padding:6px 22px 14px;margin:22px 0}
    .tldr h2{margin-top:14px;font-size:17px}
    .tldr blockquote{margin:10px 0 0;padding:0;border:0;background:transparent}
    .tldr blockquote p{margin:6px 0;padding:8px 12px 8px 36px;background:#fff;border-radius:2px;border:1px solid #e0f2fe;position:relative;font-size:15px;font-weight:600;color:#0f172a}
    .tldr blockquote p::before{content:">";position:absolute;left:14px;color:#0891b2;font-weight:800;font-family:var(--mono)}
    /* 編集部の井戸端会議（吹き出し） */
    .kaigi{background:#fafcff;border:1px solid #dbe7ef;border-radius:4px;padding:6px 18px 16px;margin:26px 0}
    .kaigi h2{margin-top:14px}
    .kaigi em{display:block;font-size:12px;color:var(--mut);font-style:normal;margin:0 0 10px}
    .kaigi .say{display:flex;gap:10px;align-items:flex-start;margin:10px 0}
    .kaigi .av{flex:none;width:36px;height:36px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-weight:800;color:#fff;font-size:15px}
    .kaigi .bub{background:#fff;border:1px solid #e2e8f0;border-radius:4px 14px 14px 14px;padding:8px 12px;font-size:14.5px;line-height:1.7;max-width:640px}
    .kaigi .bub b{display:block;font-size:11.5px;margin-bottom:2px}
    .kaigi .say-sakura .av{background:#0e7490}.kaigi .say-sakura b{color:#0e7490}
    .kaigi .say-mina .av{background:#c026d3}.kaigi .say-mina b{color:#a21caf}
    .kaigi .say-takeshi .av{background:#7c3aed}.kaigi .say-takeshi b{color:#6d28d9}
    .kaigi .say-sakura{flex-direction:row-reverse}.kaigi .say-sakura .bub{border-radius:14px 4px 14px 14px;background:#ecfeff}
    /* スレの流れ（まとめサイト風のレス） */
    ol.thread{list-style:none;padding:0;margin:8px 0 0;font-size:14px}
    ol.thread li{display:grid;grid-template-columns:auto auto 1fr;gap:8px;align-items:baseline;padding:7px 0;border-top:1px dashed #f0abfc}
    ol.thread li .no{color:#a21caf;font-weight:800;font-family:var(--mono)}
    ol.thread li .nm{color:#16a34a;font-weight:700;font-size:12.5px}
    ol.thread li .tx{color:#1f2937}
    ol.thread li.desk{background:#fff;border:1px solid #a5f3fc;border-radius:2px;padding:10px 12px;margin-bottom:6px}
    ol.thread li.desk .nm{color:#0e7490}
    ol.thread li.desk .tx{font-weight:600;color:#0f172a}
    ol.thread li.abroad .nm{color:#7c3aed}
    /* スマホで本文が右の細い列に押し込まれていた（2026-09-23 iPhone 実測）。狭い画面では番号・名前を1行目、本文を2行目の全幅に */
    @media (max-width:600px){
      ol.thread li{grid-template-columns:auto 1fr;row-gap:2px}
      ol.thread li .tx{grid-column:1 / -1}
      .reactions,.kaigi,.tldr{padding-left:12px;padding-right:12px}
    }
    .thread-box h2{}
    /* ネットの反応（まとめサイト風の箱。JSで包むので is:global） */
    .reactions{background:linear-gradient(180deg,#fdf4ff,#fff);border:1px solid #f5d0fe;border-radius:4px;padding:4px 22px 16px;margin:26px 0}
    .reactions h2{margin-top:16px}
    .reactions h3{font-size:15px;margin:18px 0 6px}
    .reactions p{font-size:15px}
    .reactions p:last-child{font-size:12.5px;color:var(--mut)}
  </style>
  <style>
    .pricelog{background:#f5feff;border:1px solid #a5f3fc;border-radius:4px;padding:14px 18px;margin:0 0 24px}
    .pricelog .pl-title{font-weight:800;color:#0c4a6e;font-size:13.5px;margin-bottom:6px}
    .pricelog .pl-body{font-size:13px;color:#0f172a;margin:0 0 6px}
    .pricelog .pl-note{font-size:11.5px;color:#64748b;margin:0}
    .authorbox{display:flex;gap:14px;background:#fff;border:1px solid #dbe7ef;border-radius:4px;padding:16px 18px;margin:34px 0 0}
    .authorbox .ab-av{flex:none;line-height:0}
    .authorbox b{color:#0f2744;font-size:14px}
    .authorbox p{font-size:12.5px;color:#475569;line-height:1.8;margin:4px 0 0}
  </style>
</Base>
