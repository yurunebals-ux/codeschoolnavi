---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import Thumb from "../../components/Thumb.astro";

export async function getStaticPaths() {
  const posts = await getCollection("blog", ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { slug: post.slug }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await post.render();
const d = post.data;
const cat = d.title.includes("給付金") ? "給付金" : (d.title.includes("比較") || d.title.includes("おすすめ")) ? "比較" : d.title.includes("評判") ? "評判・口コミ" : "解説";
---
<Base title={d.title} description={d.description} article={d}>
  <article>
    <h1>{d.title}</h1>
    <div class="meta">
      <span class="badge">✓ 3軸で検証済み</span>
      <span>更新日: {d.updatedDate || d.pubDate}</span>
      <span>執筆: {d.author}</span>
    </div>
    <div class="eyecatch"><Thumb title={d.title} cat={cat} /></div>
    <nav class="toc" id="toc" hidden>
      <div class="toc-title">📑 この記事の目次</div>
      <ol id="toc-list"></ol>
    </nav>
    <Content />
  </article>
  <script is:inline>
    // 目次を h2 から自動生成（CVR: 迷子防止と要点への直行導線）
    const hs = Array.from(document.querySelectorAll("main article h2"));
    if (hs.length >= 2) {
      const list = document.getElementById("toc-list");
      hs.forEach((h, i) => {
        if (!h.id) h.id = "sec-" + (i + 1);
        const li = document.createElement("li");
        const a = document.createElement("a");
        a.href = "#" + h.id;
        a.textContent = h.textContent.replace(/^[0-9]+\.\s*/, "");
        li.appendChild(a);
        list.appendChild(li);
      });
      document.getElementById("toc").hidden = false;
    }
  </script>
</Base>
