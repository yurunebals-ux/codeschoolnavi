---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import Thumb from "../../components/Thumb.astro";
import pricewatch from "../../data/pricewatch.json";

export async function getStaticPaths() {
  const posts = await getCollection("blog", ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { slug: post.slug }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await post.render();
const d = post.data;
const cat = d.title.includes("給付金") ? "給付金" : (d.title.includes("比較") || d.title.includes("おすすめ")) ? "比較" : d.title.includes("評判") ? "評判・口コミ" : "解説";

// 独自データ：この記事のスクールに公式料金の観測記録があれば「監視ログ」を表示。
// slug 規約 hyoban-<id> と pricewatch.json のキーを対応させる。
const watchId = post.slug.startsWith("hyoban-") ? post.slug.slice("hyoban-".length) : null;
const watch = watchId ? (pricewatch as any).schools?.[watchId] : null;
const hasWatch = !!(watch && watch.lastChecked);
const changeDates: string[] = hasWatch ? watch.observations.map((o: any) => o.date).slice(-5).reverse() : [];
---
<Base title={d.title} description={d.description} article={d}>
  <article>
    <h1>{d.title}</h1>
    <div class="meta">
      <span class="badge">✓ 3軸で検証済み</span>
      <span>更新日: {d.updatedDate || d.pubDate}</span>
      <span>執筆: {d.author}</span>
    </div>
    <div class="eyecatch"><Thumb title={d.title} cat={cat} /></div>
    <nav class="toc" id="toc" hidden>
      <div class="toc-title">📑 この記事の目次</div>
      <ol id="toc-list"></ol>
    </nav>
    {hasWatch && (
      <aside class="pricelog">
        <div class="pl-title">🔎 料金表示の自動監視（当サイト独自）</div>
        <p class="pl-body">
          {watch.name}の公式サイトの料金表示を毎日自動で確認しています。
          <b>最終確認日: {watch.lastChecked}</b>
          {changeDates.length > 0 && <span> ／ 表示の変化を検出した日: {changeDates.join("、")}</span>}
        </p>
        <p class="pl-note">※価格そのものは必ず<a href={watch.url} target="_blank" rel="nofollow noopener">公式サイト</a>でご確認ください。本ログは記事の料金情報が古くなっていないかを確認するための当サイト独自の仕組みです。</p>
      </aside>
    )}
    <Content />
  </article>
  <script is:inline>
    // 目次を h2 から自動生成（CVR: 迷子防止と要点への直行導線）
    const hs = Array.from(document.querySelectorAll("main article h2"))
      .filter((h) => !/あわせて読みたい|関連記事/.test(h.textContent));
    if (hs.length >= 2) {
      const list = document.getElementById("toc-list");
      hs.forEach((h, i) => {
        if (!h.id) h.id = "sec-" + (i + 1);
        const li = document.createElement("li");
        const a = document.createElement("a");
        a.href = "#" + h.id;
        a.textContent = h.textContent.replace(/^[0-9]+\.\s*/, "");
        li.appendChild(a);
        list.appendChild(li);
      });
      document.getElementById("toc").hidden = false;
    }
  </script>
  <style>
    .pricelog{background:#f0f9ff;border:1px solid #bae6fd;border-radius:12px;padding:14px 18px;margin:0 0 24px}
    .pricelog .pl-title{font-weight:800;color:#0c4a6e;font-size:13.5px;margin-bottom:6px}
    .pricelog .pl-body{font-size:13px;color:#0f172a;margin:0 0 6px}
    .pricelog .pl-note{font-size:11.5px;color:#64748b;margin:0}
  </style>
</Base>
