  <h3>やることを順番どおりに</h3>
  <ol class="steps2">
    <li><b>講座を検索して対象か確認する</b><span>厚生労働省の教育訓練給付制度［検索システム］で、コース名そのものを検索します。スクール名で出てきても、コースが違えば対象外です。</span></li>
    <li><b>ハローワークに電話して予約する</b><span>住所を管轄するハローワークです。専門実践・特定一般は訓練前キャリアコンサルティングの予約が必要で、混みます。受講開始日から逆算して1か月前には連絡してください。</span></li>
    <li><b>ジョブ・カードを作る</b><span>キャリアコンサルタントと面談しながら作成します。当日いきなりは作れないので、様式を先に見ておくと早く終わります。</span></li>
    <li><b>受給資格確認票を提出する</b><span>ジョブ・カードと本人確認書類を添えて、<b>受講開始日の2週間前まで</b>に提出します。この日付が制度の分かれ目です。</span></li>
    <li><b>スクールに申し込み、受講料を払う</b><span>領収書と受講証明書は捨てないでください。支給申請でそのまま必要になります。</span></li>
    <li><b>期限内に支給申請する</b><span>専門実践は6か月ごと、一般・特定一般は修了後1か月以内。就職や賃上げの上乗せ分は、それぞれ別の期限で追加申請します。</span></li>
  </ol>

  <h2>働いていない人向けの、もう一つの給付金</h2>
  <p>
    専門実践の対象講座を受ける<b>45歳未満の離職者</b>には、受講中の生活費にあてる<b>教育訓練支援給付金</b>があります。額は雇用保険の基本手当日額の60%で、2か月ごとに支給されます（令和7年4月1日より前に受講を開始した人は80%）。
    これは令和8年度末までの暫定措置なので、使うつもりなら期限を意識してください。受講に専念することが条件で、働きながらは使えません。
  </p>

  <h2>ここで失敗する人が多い、5つの落とし穴</h2>
  {pitfalls.map((p) => (
    <details>
      <summary>{p.q}</summary>
      <p>{p.a}</p>
    </details>
  ))}

  <h2>次にやること</h2>
  <p>
    制度の側の条件が分かったら、次は「対象講座を持っているスクールのうち、自分の目的に合うのはどれか」です。順番を逆にすると、対象外のコースに申し込んでから気づくことになります。
  </p>
  <ul class="bd">
    <li><a href="/blog/kyufukin-osusume/">給付金対象コースがあるスクールの比較を読む</a></li>
    <li><a href="/shindan/">30秒診断で、目的別の候補校を見る</a></li>
    <li><a href="/about/">当サイトが何をどう検証しているか</a></li>
  </ul>

  <div class="disc">
    <b>この記事の位置づけ</b>
    <p>
      当サイトは制度の運営主体ではありません。ここに書いた条件・金額はいずれも厚生労働省およびハローワークの公表資料にもとづきますが、制度は毎年改正されます。
      実際の受給可否と金額は、必ず住所を管轄するハローワークで確認してください。当サイトの記載と公的機関の案内が食い違う場合は、公的機関の案内が正です。
    </p>
    <p class="who">文責：編集長 佐倉 透（さくら とおる）／最終確認 2026年7月</p>
  </div>

  <script is:inline>
    // 給付金の判定。設問の答え → 3区分それぞれの可否を出す。
    // 「対象外です」で終わらせず、何がひっかかっていて次に何をすればいいかまで返す。
    (function () {
      var root = document.getElementById("judge");
      if (!root) return;
      var out = document.getElementById("j-result");
      var sub = document.getElementById("j-sub-repeat");

      function val(name) {
        var el = root.querySelector('input[name="' + name + '"]:checked');
        return el ? el.value : null;
      }

      // 区分ごとの静的な情報。本文の表と数字がずれないよう、文言はここに集約する。
      var TYPES = [
        { key: "ippan",   name: "一般教育訓練",   rate: "20%・上限10万円", needYears: 1, needPre: false },
        { key: "tokutei", name: "特定一般教育訓練", rate: "40%・上限20万円", needYears: 1, needPre: true },
        { key: "senmon",  name: "専門実践教育訓練", rate: "最大80%・年間上限64万円", needYears: 2, needPre: true }
      ];

      function judge() {
        var course = val("course"), hoken = val("hoken"), kaisu = val("kaisu");
        var span3 = val("span3"), years = val("years"), status = val("status"), lead = val("lead");

        sub.hidden = kaisu !== "repeat";
        if (kaisu !== "repeat") {
          var s3 = root.querySelector('input[name="span3"]:checked');
          if (s3) s3.checked = false;
          span3 = null;
        }

        var needSpan3 = kaisu === "repeat";
        var answered = course && hoken && kaisu && years && status && lead && (!needSpan3 || span3);
        if (!answered) {
          out.innerHTML = '<p class="j-wait">上の設問に答えると、ここに判定結果が出ます。</p>';
          out.className = "j-result";
          return;
        }

        // どの区分でも共通で効く足切り。ひとつでも該当したら、そこを片づけるのが先。
        var stops = [];
        if (course === "no") {
          stops.push(["受けたい講座が対象講座ではありません", "対象になるのは講座単位です。同じスクールでも対象コースと対象外コースが混在します。スクールに「教育訓練給付の対象コースはどれか」を直接聞くのがいちばん早いです。"]);
        }
        if (hoken === "no") {
          stops.push(["雇用保険の加入歴がありません", "この制度は雇用保険から出ています。加入歴がないと、どの区分も対象になりません。就職して加入期間を積むところからになります。"]);
        }
        if (needSpan3 && span3 === "no") {
          stops.push(["前回の受給から3年経っていません", "2回目以降は前回の受給から3年以上あける必要があります。3年が経過する時期を確認し、受講開始日をそこから後ろにずらせます。"]);
        }
        if (status === "left2") {
          stops.push(["離職から1年を超えています", "原則は離職日の翌日から1年以内に受講を開始する必要があります。ただし病気・出産・育児・介護などの理由があれば適用対象期間の延長が認められる場合があります。まずハローワークで延長の可否を確認してください。"]);
        }

        var html = "";
        if (stops.length) {
          out.className = "j-result is-stop";
          html += '<p class="j-rt">いまのままでは、どの区分も対象になりません</p>';
          html += '<ul class="j-stops">';
          for (var i = 0; i < stops.length; i++) {
            html += "<li><b>" + stops[i][0] + "</b><span>" + stops[i][1] + "</span></li>";
          }
          html += "</ul>";
          if (course === "unknown") {
            html += '<p class="j-note">講座が対象かどうかはまだ未確認です。ここが決まらないと他の条件を満たしても受け取れません。</p>';
          }
          out.innerHTML = html;
          return;
        }

        // 足切りを抜けたので、区分ごとに見る。
        var y = years === "ge2" ? 2 : years === "mid" ? 1 : 0;
        var rows = [], anyOk = false;
        for (var k = 0; k < TYPES.length; k++) {
          var t = TYPES[k], state, why;
          if (y < t.needYears) {
            state = "ng";
            why = "雇用保険の加入期間が" + t.needYears + "年に届いていません。" +
                  (t.needYears === 2 ? "一般・特定一般は1年以上で足りるので、そちらを先に検討できます。" : "加入期間を満たす時期を確認し、受講開始日をずらすと対象になります。");
          } else if (t.needPre && lead === "ng") {
            state = "cond";
            why = "条件は満たしていますが、事前手続きが受講開始の2週間前までに終わりません。受講開始日を2週間以上あとにずらせば対象になります。キャリアコンサルティングの予約が取れる日から逆算してください。";
            anyOk = true;
          } else {
            state = "ok";
            why = t.needPre
              ? "受講開始の2週間前までに、キャリアコンサルティング・ジョブカード・受給資格確認票をハローワークに出してください。"
              : "事前手続きは不要です。修了後に支給申請します。";
            anyOk = true;
          }
          rows.push({ t: t, state: state, why: why });
        }

        out.className = "j-result " + (anyOk ? "is-ok" : "is-stop");
        html += '<p class="j-rt">' + (anyOk ? "対象になりうる区分があります" : "いまの加入期間では、どの区分にも届いていません") + "</p>";
        html += '<ul class="j-rows">';
        for (var m = 0; m < rows.length; m++) {
          var r = rows[m];
          var label = r.state === "ok" ? "対象になりえます" : r.state === "cond" ? "日程を動かせば対象" : "いまは対象外";
          html += '<li class="r-' + r.state + '"><b>' + r.t.name + "</b><em>" + r.t.rate + "</em><i>" + label + "</i><span>" + r.why + "</span></li>";
        }
        html += "</ul>";
        if (course === "unknown") {
          html += '<p class="j-note">受けたい講座が対象講座かどうかは未確認です。ここが違うと、他の条件を満たしていても受け取れません。先に講座名で確認してください。</p>';
        }
        if (status === "left1") {
          html += '<p class="j-note">離職中の方は、離職日の翌日から1年以内に受講を開始する必要があります。受講開始日が期限内に収まるか確認してください。</p>';
        }
        html += '<p class="j-next">対象になりうる区分が分かったら、次は<a href="/blog/kyufukin-osusume/">その区分の対象コースを持つスクールの比較</a>を見てください。区分によって候補は変わります。</p>';
        out.innerHTML = html;
      }

      root.addEventListener("change", judge);
      judge();
    })();
  </script>

  <!-- 判定結果は JS が実行時に生成する。Astro のスコープ付き style は
       data-astro-cid が付いた要素にしか当たらないので、この部分だけ global にする。
       他ページに漏れないよう、すべて #judge 配下に限定している。 -->
  <style is:global>
    #judge .j-wait{font-size:13px;color:#64748b;margin:0}
    #judge .j-rt{font-size:15px;font-weight:800;color:#0f2744;margin:0 0 10px}
    #judge .j-rows,#judge .j-stops{list-style:none;padding:0;margin:0;display:grid;gap:9px}
    #judge .j-rows li{background:#fff;border:1px solid #e2e8f0;border-left:4px solid #cbd5e1;border-radius:10px;padding:11px 13px;margin:0}
    #judge .j-rows li.r-ok{border-left-color:#16a34a}
    #judge .j-rows li.r-cond{border-left-color:#f59e0b}
    #judge .j-rows li.r-ng{border-left-color:#cbd5e1;opacity:.85}
    #judge .j-rows b{font-size:14px;color:#0f2744;margin-right:8px;background:none}
    #judge .j-rows em{font-size:12.5px;color:#475569;font-style:normal}
    #judge .j-rows i{display:block;font-style:normal;font-size:12.5px;font-weight:800;margin:5px 0 3px}
    #judge .j-rows li.r-ok i{color:#15803d}
    #judge .j-rows li.r-cond i{color:#b45309}
    #judge .j-rows li.r-ng i{color:#64748b}
    #judge .j-rows span{display:block;font-size:13px;color:#475569;line-height:1.85}
    #judge .j-stops li{background:#fff;border:1px solid #fdba74;border-radius:10px;padding:11px 13px;margin:0}
    #judge .j-stops b{display:block;font-size:14px;color:#9a3412;margin-bottom:3px;background:none}
    #judge .j-stops span{display:block;font-size:13px;color:#475569;line-height:1.85}
    #judge .j-note{font-size:12.5px;color:#475569;line-height:1.85;margin:10px 0 0;padding-left:12px;border-left:3px solid #cbd5e1}
    #judge .j-next{font-size:13.5px;color:#334155;line-height:1.85;margin:12px 0 0}
  </style>

