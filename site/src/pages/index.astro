---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
const posts = (await getCollection("blog", ({ data }) => !data.draft))
  .sort((a, b) => +new Date(b.data.pubDate) - +new Date(a.data.pubDate));
---
<Base title="プログラミングスクールの比較・評判" description="主要なプログラミングスクールを料金・評判・特徴で比較し、あなたに合う一校を解説します。">
  <h1>プログラミングスクールを、正直に比較</h1>
  <p>料金・サポート・転職実績を実際に比較し、目的別におすすめを解説します。当サイトはアフィリエイト広告を利用していますが、評価や順位には影響しません。</p>
  <ul>
    {posts.map((p) => (
      <li>
        <a href={`/blog/${p.slug}/`}>{p.data.title}</a>
        <span style="color:var(--mut);font-size:13px"> — {p.data.pubDate}</span>
      </li>
    ))}
  </ul>
  {posts.length === 0 && <p><em>新しい記事を順次公開しています。もうしばらくお待ちください。</em></p>}
</Base>
