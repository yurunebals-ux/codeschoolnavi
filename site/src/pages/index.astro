---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import Thumb from "../components/Thumb.astro";
import Cta from "../components/Cta.astro";
import HeroArt from "../components/HeroArt.astro";
import Shot from "../components/Shot.astro";
import shotsFile from "../data/shots.json";
import NavIcon from "../components/NavIcon.astro";
import { catOf } from "../lib/cat";
import { shotsFor } from "../lib/school";
import schools from "../data/schools.json";
import pricewatch from "../data/pricewatch.json";
import offersFile from "../data/offers.json";

// 比較表の「公式」列。CTAと同じ offers.json から引くので、提携が承認されれば
// ここも自動でアフィリンクに変わる。出せるURLが無い行はリンクを出さない。
const offers = (offersFile as any).offers ?? {};
const hasSponsored = schools.table.some((s: any) => offers[s.id]?.sponsored)
  || schools.picks.some((s: any) => offers[s.id]?.sponsored);

const posts = (await getCollection("blog", ({ data }) => !data.draft))
  .sort((a, b) => +new Date(b.data.pubDate) - +new Date(a.data.pubDate));
const chip = (p: any) => catOf(p.data.title, p.data);
const latest = posts[0]?.data.pubDate ?? "";
// AIニュースへの見解（毎日）。読みに来るだけの理由を作る（オーナー方針 2026-09-14）
const newsPosts = posts.filter((p) => p.data.news).slice(0, 3);

// 案C: ヒーローに料金監視の稼働実績を出す。「毎日実際に動いているサイト」であることを一次情報で示す。
// 価格そのものは断定せず、監視校数・最終確認日・表示変化の検知件数だけを主張する（景表法・自動監視の性質上）。
const watched = Object.values((pricewatch as any).schools ?? {}) as any[];
const pwCount = watched.length;
const pwLast = watched.map((s) => s.lastChecked).filter(Boolean).sort().pop() ?? "";
const pwChanges = watched.reduce((n, s) => n + (s.observations?.length ?? 0), 0);
const pwLastMd = pwLast ? `${Number(pwLast.slice(5, 7))}/${Number(pwLast.slice(8, 10))}` : "—";

// ヒーロー右側に敷く「公式サイトの画面」の扇。競合分析（2026-09-11）で上位サイトのヒーローに
// 人物写真は無く、代わりに「実物の画面」が信頼感を作っていた。スクショがある校のうち
// 比較表に載っている校を優先し、最大3枚。無ければ従来のSVGだけで描く（何も壊れない）。
const shotIds = Object.keys((shotsFile as any).shots ?? {});
const heroShots = [
  ...schools.table.map((s: any) => s.id),
  ...schools.picks.map((s: any) => s.id),
].filter((id, i, a) => a.indexOf(id) === i && shotIds.includes(id)).slice(0, 3)
 .map((id) => ({ id, name: (schools.table.find((s: any) => s.id === id) ?? schools.picks.find((s: any) => s.id === id))?.name ?? id }));
---
<Base home={true} title="プログラミングスクールの比較・評判" description="主要プログラミングスクールの受講料・期間・給付金・転職支援を横並びで比較。評判記事は毎日更新、デメリットも正直に記載します。">
  <section class="hero" slot="hero"><HeroArt />
    {heroShots.length > 0 && (
      <div class="hero-shots" aria-hidden="true">
        {heroShots.map((h, i) => (
          <div class={`hs hs-${i}`}><Shot id={h.id} name={h.name} variant="plain" eager={true} /></div>
        ))}
      </div>
    )}
    <div class="wrap">
    <p class="kicker">スクール選びで後悔したくない人のための比較サイト</p>
    <h1>受講料・給付金・転職支援。<br />答えは<mark>「横並びの比較」</mark>で出す。</h1>
    <p>主要スクールの受講料・期間・保証内容を公式情報から整理し、ひとつの表で比べられるようにしました。給付金で受講料の20〜80%が戻る仕組みも、区分ごとの条件つきで解説。デメリットも隠さず書きます。</p>
    <div class="actions">
      <a class="primary" href="/shindan/">6問で合う3校を診断する</a>
      <a class="ghost" href="/blog/kyufukin-osusume/">給付金で安くする方法を見る</a>
    </div>
    <ul class="points">
      <li>掲載{schools.table.length}校を同じ軸で比較</li>
      <li>評判記事{posts.length}本・毎日更新（最終更新 {latest}）</li>
      <li>広告の有無は評価に影響しません</li>
    </ul>

    <a class="pw" href="/about/">
      <span class="pw-head"><i class="dot"></i>料金監視 稼働中<em>当サイト独自</em></span>
      <span class="pw-stats">
        <span class="pw-cell"><b data-count={pwCount}>{pwCount}<small>校</small></b><small>掲載＋候補校の公式料金</small></span>
        <span class="pw-cell"><b>{pwLastMd}</b><small>最終確認日</small></span>
        <span class="pw-cell"><b data-count={pwChanges}>{pwChanges}<small>件</small></b><small>表示変化を検知</small></span>
      </span>
      <span class="pw-note">記事の料金が古くならないよう自動観測しています。価格は必ず公式サイトでご確認ください →</span>
    </a>
  </div></section>

  {/* 編集長の紹介はトップに出さない（オーナー判断 2026-09-11）。運営者情報と記事ページには残る */}

  <section class="sec">
    <div class="sec-head reveal"><h2>目的から探す</h2><span class="en">PURPOSE</span></div>
    <div class="nav4">
      <a class="navcard reveal" style="--i:0" href="/blog/hyoban-dmmwebcamp/"><NavIcon kind="tenshoku" /><b>転職を目指す</b><small>転職保証つきスクールの実力は</small></a>
      <a class="navcard reveal" style="--i:1" href="/blog/kyufukin-osusume/"><NavIcon kind="kyufu" /><b>給付金で安く</b><small>区分別の還元率と対象校</small></a>
      <a class="navcard reveal" style="--i:2" href="/blog/hyoban-techacademy/"><NavIcon kind="online" /><b>オンライン完結</b><small>働きながら自宅で学びたい</small></a>
      <a class="navcard reveal" style="--i:3" href="/shindan/"><NavIcon kind="shindan" /><b>迷ったら診断</b><small>6問で合う3校と注意点を出す</small></a>
    </div>
  </section>

  {newsPosts.length > 0 && (
    <section class="sec band-warm" style="--sec-c:#ea580c" id="news">
      <div class="sec-head reveal"><h2>AIニュースの見方</h2><span class="en">NEWS DESK</span><span class="note">国内外のAI・エンジニア採用のニュースに、学ぶ人の立場で賛否と結論を書いています</span></div>
      <ul class="cards news3">
        {newsPosts.map((p, i) => (
          <li class="reveal" style={`--i:${i}`}>
            <a class="card row" data-cat="ニュース" href={`/blog/${p.slug}/`}>
              <span class="cbody">
                <span class="chip">{i === 0 ? "最新の見解" : "編集部コラム"}</span>
                <span class="t">{p.data.title}</span>
                <span class="d">{p.data.pubDate}</span>
              </span>
            </a>
          </li>
        ))}
      </ul>
      <a class="more-link reveal" href="/news/">ニュースの見解をすべて読む →</a>
    </section>
  )}

  <section class="sec band-blue">
    <div class="sec-head reveal"><h2>編集部ピックアップ</h2><span class="en">EDITOR'S PICK</span><span class="note">目的別・公開情報に基づく編集部の見解です</span></div>
    <div class="picks">
      {schools.picks.map((s, i) => (
        <article class="pick reveal" style={`--i:${i}`}>
          <Shot id={s.id} name={s.name} variant="card" />
          <div class="ribbon">{s.purpose}</div>
          <h3>{s.name}<small>{s.sub}</small></h3>
          <dl class="specs">
            <div><dt>料金</dt><dd><b>{s.price}</b></dd></div>
            <div><dt>期間</dt><dd>{s.period}</dd></div>
            <div><dt>形式</dt><dd>{s.form}</dd></div>
          </dl>
          <ul class="tags">{s.tags.map((tg) => <li>{tg}</li>)}</ul>
          <p class="fit">✓ {s.fit}</p>
          <a class="more" href={s.review}>評判・注意点をくわしく見る</a>
          <Cta id={s.id} variant="slim" />
        </article>
      ))}
    </div>
  </section>

  <section class="sec">
    <div class="sec-head reveal"><h2>掲載{schools.table.length}校をざっくり比較</h2><span class="en">COMPARISON</span></div>
    <table>
      <thead><tr><th>スクール</th><th>形式</th><th>期間</th><th>料金（税込）</th><th>ここが特徴</th><th>詳細</th></tr></thead>
      <tbody>
        {schools.table.map((s) => (
          <tr>
            {/* 公式リンクは独立した列にすると、表が横スクロールする幅のときに
                画面外へ追い出されて誰にも押されない（実際そうなった）。
                横スクロールしても残る1列目に入れる。 */}
            <td class="tname"><b>{s.name}</b>{offers[s.id] && (
              <><br /><a class="t-official" href={offers[s.id].href} target="_blank" rel={offers[s.id].sponsored ? "sponsored nofollow noopener" : "nofollow noopener"}>公式サイト ↗{offers[s.id].sponsored && <span class="cta-pr">PR</span>}</a></>
            )}</td>
            <td>{s.form}</td><td>{s.period}</td><td>{s.price}</td><td>{s.point}</td>
            <td><a href={s.review}>評判を見る</a></td>
          </tr>
        ))}
      </tbody>
    </table>
    <p class="tnote">※料金・内容は各記事の更新日時点の公式情報に基づきます。最新条件は必ず公式サイトでご確認ください。
      {hasSponsored && <span> 「PR」の付いたリンクは広告（アフィリエイト）リンクです。報酬の有無は掲載順・評価に影響しません。</span>}</p>
  </section>

  <section class="sec band-green" style="--sec-c:#059669">
    <div class="sec-head reveal"><h2>新着の評判・比較記事</h2><span class="en">ARTICLES</span><span class="note">全{posts.length}本 ・ 毎日更新</span></div>
    {/* 全部を同じ大きさのサムネで並べると、10枚のグラデーションが延々と続いて
        「量産テンプレ」に見える（実測: この一覧だけでページの33%＝1,842pxあった）。
        最新1本だけ大きく見せ、残りは横組みの小カードにして、リズムと情報密度を上げる。 */}
    {posts[0] && (
      <a class="feat reveal" data-cat={chip(posts[0])} href={`/blog/${posts[0].slug}/`}>
        <span class="feat-thumb"><Thumb title={posts[0].data.title} cat={chip(posts[0])} shots={shotsFor(posts[0].slug)} eager={true} /></span>
        <span class="feat-body">
          <span class="feat-tags"><span class="chip">{chip(posts[0])}</span><span class="feat-new">最新</span></span>
          <span class="feat-t">{posts[0].data.title}</span>
          <span class="feat-d">{posts[0].data.description}</span>
          <span class="d">{posts[0].data.pubDate} 更新 ・ {posts[0].data.author}</span>
        </span>
      </a>
    )}
    {/* 一覧は10本で止めて /blog/ に送る。52本を縦に並べるとページの半分が同じ形のカードになり、
        オーナー評「味気ない」の主因になっていた。 */}
    <ul class="cards">
      {posts.slice(1, 11).map((p, i) => (
        <li class="reveal" style={`--i:${i % 2}`}>
          <a class="card row" data-cat={chip(p)} href={`/blog/${p.slug}/`}>
            <span class="cthumb"><Thumb title={p.data.title} cat={chip(p)} shots={shotsFor(p.slug)} compact /></span>
            <span class="cbody">
              <span class="chip">{chip(p)}</span>
              <span class="t">{p.data.title}</span>
              <span class="d">{p.data.pubDate} 更新</span>
            </span>
          </a>
        </li>
      ))}
    </ul>
    <a class="more-link reveal" href="/blog/">すべての記事を見る（全{posts.length}本）→</a>
  </section>

  <section class="sec" style="--sec-c:#7c3aed">
    <div class="sec-head reveal"><h2>失敗しない選び方 3ステップ</h2><span class="en">HOW TO CHOOSE</span></div>
    <ol class="steps">
      <li class="reveal" style="--i:0"><b>目的を決める</b><span>転職が最優先なら保証つき、スキル習得だけならオンライン完結型も選択肢。</span></li>
      <li class="reveal" style="--i:1"><b>給付金の対象か調べる</b><span>対象コースなら受講料の20〜80%が戻ります。割合は講座の指定区分と雇用保険の加入期間で変わるので、申込前に確認を。</span></li>
      <li class="reveal" style="--i:2"><b>負担額で比べる</b><span>定価ではなく「給付金適用後の自己負担」で比較すると順位が入れ替わることがあります。</span></li>
    </ol>
  </section>

  <section class="sec band-warm" style="--sec-c:#ea580c">
    <div class="sec-head reveal"><h2>よくある質問</h2><span class="en">FAQ</span></div>
    <details><summary>「プログラミングスクールは意味がない」と聞きますが本当ですか？</summary><p>独学で十分な人がいる一方、保証や伴走が必要な人もいます。費用が高く感じられる背景と、向き不向きの整理は<a href="/blog/kyufukin-osusume/">こちらの記事</a>で中立的に解説しています。</p></details>
    <details><summary>給付金はいくら戻りますか？</summary><p>講座の指定区分で変わります。一般教育訓練は20%（上限10万円）、特定一般は40%（上限20万円）、専門実践は受講中50%（年間上限40万円）で、修了後に就職すると20%・賃金が上がるとさらに10%が上乗せされ最大80%（年間上限64万円）です。専門実践と特定一般は<b>受講開始日の2週間前まで</b>にハローワークでの手続きが必要です。対象校と申請手順は<a href="/kyufukin/">給付金の使い方</a>と<a href="/blog/kyufukin-osusume/">給付金対象スクールまとめ</a>をご覧ください。</p></details>
    <details><summary>このサイトの評価は広告に影響されますか？</summary><p>されません。当サイトはアフィリエイト広告を利用していますが、記事の評価・掲載順は編集部の検証ルール（教育の質・サポート・実績の3軸）のみで決めています。詳細は<a href="/disclosure/">広告について</a>へ。</p></details>
  </section>

  <section class="sec policy">
    <div class="sec-head reveal"><h2>編集方針</h2><span class="en">EDITORIAL POLICY</span></div>
    <p>コードスクールナビ編集部は、各スクールの<b>公式サイト・料金表・給付金の指定講座情報</b>を定期的に確認し、「教育の質」「サポート」「実績」の3軸で整理しています。良い点だけでなく<b>注意点・向かない人</b>を必ず記載し、記事には更新日を明示します。内容の誤りを見つけた場合は<a href="/about/">運営者情報</a>のページからご連絡ください。</p>
  </section>
</Base>
