---
// トップページ（2026-09-23 ニュースサイト寄りに作り直し）
// オーナー方針: 「まずはアクセス数を増やすサイトを構築する。アフィリエイトは全面に出さない」「トップページもニュースサイトよりに」
// 構成: 日付入りの題字 → トップニュース（大1＋中2）→ 新着ニュース一覧 → 話題のスレ（反応順）→ 週間コラム → 学び・キャリアの読み物 → スクール選びの資料室（折りたたみ比較表つき）
// トップにはアフィリエイト・申込ボタンを置かない。スクールの申込導線は各校記事の末尾だけ。
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import Thumb from "../components/Thumb.astro";
import NavIcon from "../components/NavIcon.astro";
import { catOf } from "../lib/cat";
import { shotsFor } from "../lib/school";
import schools from "../data/schools.json";

const posts = (await getCollection("blog", ({ data }) => !data.draft))
  .sort((a, b) => +new Date(b.data.pubDate) - +new Date(a.data.pubDate) || (b.data.reactions ?? 0) - (a.data.reactions ?? 0));
const chip = (p: any) => catOf(p.data.title, p.data);
const isWeekly = (p: any) => (p.body ?? "").includes("今週の読者への宿題");
const isNew = (d: string) => Date.now() - +new Date(d) < 2 * 86400000;
const md = (d: string) => `${Number(d.slice(5, 7))}/${Number(d.slice(8, 10))}`;
const rx = (n?: number) => (n ? `反応${n.toLocaleString()}` : "");

const news = posts.filter((p) => p.data.news);
const matome = news.filter((p) => !isWeekly(p));
const weekly = news.filter((p) => isWeekly(p)).slice(0, 2);
const [lead, ...restMatome] = matome;
const subs = restMatome.slice(0, 2);
const latestList = restMatome.slice(2, 12);
// 話題のスレ: 直近14日の反応数の多い順
const hot = news
  .filter((p) => (p.data.reactions ?? 0) > 0 && Date.now() - +new Date(p.data.pubDate) < 14 * 86400000)
  .sort((a, b) => (b.data.reactions ?? 0) - (a.data.reactions ?? 0))
  .slice(0, 5);
const reads = posts.filter((p) => p.data.topic).slice(0, 4);
const schoolPosts = posts.filter((p) => !p.data.news && !p.data.topic).slice(0, 6);

// 題字の日付（ビルド時点。日本時間）
const now = new Date(Date.now() + 9 * 3600000);
const wd = ["日", "月", "火", "水", "木", "金", "土"][now.getUTCDay()];
const today = `${now.getUTCFullYear()}年${now.getUTCMonth() + 1}月${now.getUTCDate()}日（${wd}）`;
const todayCount = news.filter((p) => isNew(p.data.pubDate)).length;
---
<Base home={true} title="AIと学びのニュースまとめ・スクール比較" description="AI・プログラミング・働き方のニュースを、ネットの反応と編集部3人の見方つきで毎日まとめ。プログラミングスクールの評判・料金・給付金の比較も。">
  <section class="masthead" slot="hero">
    <div class="wrap">
      <p class="mh-date"><span>{today}</span>{todayCount > 0 && <b>新着 {todayCount}本</b>}</p>
      <h1 class="mh-title">AIと学びのニュースを、<br class="sp" />ネットの反応つきで。</h1>
      <p class="mh-lead">国内外のAI・プログラミング・働き方のニュースを毎日まとめています。スレの流れと、編集部3人の「で、学ぶ人はどうする？」を添えて。</p>
      {lead && (
        <ul class="mh-ticker">
          {[lead, ...restMatome.slice(0, 3)].map((p) => (
            <li><a href={`/blog/${p.slug}/`}><em>{md(p.data.pubDate)}</em>{p.data.title}</a></li>
          ))}
        </ul>
      )}
    </div>
  </section>

  {lead && (
    <section class="sec nx-top" id="news" style="--sec-c:#ea580c">
      <div class="sec-head"><h2>トップニュース</h2><span class="en">TOP STORIES</span><a class="note" href="/news/">ニュース一覧（{news.length}本）→</a></div>
      <div class="nx-grid">
        <a class="nx-lead" href={`/blog/${lead.slug}/`}>
          <span class="nx-thumb"><Thumb title={lead.data.title} cat="ニュース" shots={[]} eager={true} /></span>
          <span class="nx-meta">{isNew(lead.data.pubDate) && <b class="nx-new">NEW</b>}<span>{lead.data.pubDate}</span>{rx(lead.data.reactions) && <span class="nx-rx">💬 {rx(lead.data.reactions)}</span>}</span>
          <span class="nx-t">{lead.data.title}</span>
          <span class="nx-d">{lead.data.description}</span>
        </a>
        <div class="nx-subs">
          {subs.map((p) => (
            <a class="nx-sub" href={`/blog/${p.slug}/`}>
              <span class="nx-thumb"><Thumb title={p.data.title} cat="ニュース" shots={[]} /></span>
              <span class="nx-meta">{isNew(p.data.pubDate) && <b class="nx-new">NEW</b>}<span>{p.data.pubDate}</span>{rx(p.data.reactions) && <span class="nx-rx">💬 {rx(p.data.reactions)}</span>}</span>
              <span class="nx-t">{p.data.title}</span>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="sec nx-two" style="--sec-c:#ea580c">
    <div class="nx-col">
      <div class="sec-head"><h2>新着ニュース</h2><span class="en">LATEST</span></div>
      <ul class="nx-list">
        {latestList.map((p) => (
          <li><a href={`/blog/${p.slug}/`}>
            <time>{md(p.data.pubDate)}</time>
            <span class="t">{p.data.title}{isNew(p.data.pubDate) && <b class="nx-new">NEW</b>}</span>
            {rx(p.data.reactions) && <span class="r">💬 {p.data.reactions}</span>}
          </a></li>
        ))}
      </ul>
      <a class="nx-more" href="/news/">ニュースをもっと見る →</a>
    </div>
    <aside class="nx-col nx-rank">
      <div class="sec-head"><h2>話題のスレ</h2><span class="en">RANKING</span></div>
      <ol>
        {hot.map((p, i) => (
          <li><a href={`/blog/${p.slug}/`}>
            <span class="no">{i + 1}</span>
            <span class="tx"><span class="t">{p.data.title}</span><span class="m">💬 反応{(p.data.reactions ?? 0).toLocaleString()}件 ・ {md(p.data.pubDate)}</span></span>
          </a></li>
        ))}
      </ol>
      <p class="nx-note">反応数は、元記事についた はてなブックマーク等の件数です。</p>
    </aside>
  </section>

  {weekly.length > 0 && (
    <section class="sec band-warm nx-weekly" style="--sec-c:#ea580c">
      <div class="sec-head"><h2>週間コラム</h2><span class="en">WEEKLY</span><span class="note">1週間のニュースを3本束ねて、学ぶ人への宿題つきで</span></div>
      <div class="nx-wk">
        {weekly.map((p) => (
          <a class="nx-wcard" href={`/blog/${p.slug}/`}>
            <span class="nx-meta"><span>{p.data.pubDate}</span></span>
            <span class="nx-t">{p.data.title}</span>
            <span class="nx-d">{p.data.description}</span>
          </a>
        ))}
      </div>
    </section>
  )}

  {reads.length > 0 && (
    <section class="sec nx-reads" style="--sec-c:#0d9488">
      <div class="sec-head"><h2>学び・キャリアの読み物</h2><span class="en">FEATURES</span></div>
      <ul class="cards">
        {reads.map((p) => (
          <li><a class="card row" data-cat={chip(p)} href={`/blog/${p.slug}/`}>
            <span class="cthumb"><Thumb title={p.data.title} cat={chip(p)} shots={[]} compact /></span>
            <span class="cbody"><span class="chip">{chip(p)}</span><span class="t">{p.data.title}</span><span class="d">{p.data.pubDate}</span></span>
          </a></li>
        ))}
      </ul>
    </section>
  )}

  <section class="sec band-blue nx-school">
    <div class="sec-head"><h2>スクール選びの資料室</h2><span class="en">SCHOOL GUIDE</span><span class="note">評判・料金・給付金を公式情報から整理</span></div>
    <div class="nav4">
      <a class="navcard" href="/shindan/"><NavIcon kind="shindan" /><b>6問で診断</b><small>合う3校と注意点を出す</small></a>
      <a class="navcard" href="/kyufukin/"><NavIcon kind="kyufu" /><b>給付金で安く</b><small>区分別の還元率と対象校</small></a>
      <a class="navcard" href="/blog/hyoban-dmmwebcamp/"><NavIcon kind="tenshoku" /><b>転職を目指す</b><small>転職支援つきスクールの実力</small></a>
      <a class="navcard" href="/blog/hyoban-techacademy/"><NavIcon kind="online" /><b>オンライン完結</b><small>働きながら自宅で学ぶ</small></a>
    </div>
    <ul class="nx-slist">
      {schoolPosts.map((p) => (
        <li><a href={`/blog/${p.slug}/`}><span class="chip">{chip(p)}</span><span class="t">{p.data.title}</span></a></li>
      ))}
    </ul>
    <details class="nx-table">
      <summary>掲載{schools.table.length}校の料金・期間をざっくり比較する</summary>
      <div class="tw">
        <table>
          <thead><tr><th>スクール</th><th>形式</th><th>期間</th><th>料金（税込）</th><th>詳細</th></tr></thead>
          <tbody>
            {schools.table.map((s) => (
              <tr><td class="tname"><b>{s.name}</b></td><td>{s.form}</td><td>{s.period}</td><td>{s.price}</td><td><a href={s.review}>評判を見る</a></td></tr>
            ))}
          </tbody>
        </table>
        <p class="tnote">※料金・内容は各記事の更新日時点の公式情報に基づきます。最新条件は必ず公式サイトでご確認ください。</p>
      </div>
    </details>
    <a class="nx-more" href="/blog/">スクールの記事をすべて見る →</a>
  </section>

  <section class="sec policy">
    <div class="sec-head"><h2>編集方針</h2><span class="en">EDITORIAL POLICY</span></div>
    <p>ニュースは出典を必ず明記し、「スレの流れ」には元記事についた実際のコメントだけを載せます（中傷や容姿への言及は除外）。「編集部の井戸端会議」は編集部スタッフによる会話形式のまとめで、実在の受講者の発言ではありません。スクールの記事は<b>公式サイト・料金表・給付金の指定講座情報</b>をもとに、良い点だけでなく<b>注意点・向かない人</b>も書きます。誤りを見つけた場合は<a href="/about/">運営者情報</a>からご連絡ください。</p>
  </section>
</Base>

<style is:global>
  .masthead{background:#0f172a;color:#e2e8f0;padding:26px 0 22px;border-bottom:4px solid #ea580c}
  .masthead .mh-date{display:flex;gap:10px;align-items:center;font-size:12.5px;color:#94a3b8;margin:0 0 8px;letter-spacing:.04em}
  .masthead .mh-date b{background:#ea580c;color:#fff;border-radius:999px;padding:2px 10px;font-size:11.5px}
  .masthead .mh-title{color:#fff;font-size:clamp(22px,4.6vw,32px);line-height:1.35;margin:0 0 8px}
  .masthead .mh-lead{color:#cbd5e1;font-size:14px;margin:0 0 14px;max-width:680px}
  .masthead .mh-ticker{list-style:none;margin:0;padding:10px 0 0;border-top:1px solid #334155;display:grid;gap:6px}
  .masthead .mh-ticker li{margin:0}
  .masthead .mh-ticker a{color:#e2e8f0;text-decoration:none;font-size:13.5px;display:flex;gap:10px;line-height:1.5}
  .masthead .mh-ticker a:hover{color:#fdba74}
  .masthead .mh-ticker em{font-style:normal;color:#fb923c;font-weight:800;flex:none;min-width:38px}
  .masthead br.sp{display:none}
  @media (max-width:560px){.masthead br.sp{display:inline}.masthead .mh-ticker li:nth-child(n+3){display:none}}

  .nx-meta{display:flex;gap:8px;align-items:center;font-size:12px;color:#64748b;flex-wrap:wrap}
  .nx-new{background:#dc2626;color:#fff;font-size:10.5px;font-weight:800;border-radius:4px;padding:1px 6px;margin-left:6px}
  .nx-meta .nx-new{margin-left:0}
  .nx-rx{color:#ea580c;font-weight:700}
  .nx-grid{display:grid;grid-template-columns:1.6fr 1fr;gap:18px}
  .nx-lead,.nx-sub,.nx-wcard{display:flex;flex-direction:column;gap:8px;text-decoration:none;color:var(--navy)}
  .nx-thumb{display:block;border-radius:12px;overflow:hidden;line-height:0}
  .nx-lead .nx-t{font-size:clamp(19px,3.2vw,24px);font-weight:800;line-height:1.4}
  .nx-lead .nx-d,.nx-wcard .nx-d{font-size:13.5px;color:#475569;line-height:1.7}
  .nx-subs{display:grid;gap:16px;align-content:start}
  .nx-sub .nx-t{font-size:15px;font-weight:800;line-height:1.45}
  .nx-lead:hover .nx-t,.nx-sub:hover .nx-t,.nx-wcard:hover .nx-t{color:#ea580c}

  .nx-two{display:grid;grid-template-columns:1.5fr 1fr;gap:28px}
  .nx-list{list-style:none;margin:0;padding:0;border-top:1px solid var(--bd)}
  .nx-list li{margin:0;border-bottom:1px solid var(--bd)}
  .nx-list a{display:flex;gap:12px;align-items:baseline;padding:11px 2px;text-decoration:none;color:var(--navy)}
  .nx-list time{flex:none;color:#ea580c;font-weight:800;font-size:12.5px;min-width:36px}
  .nx-list .t{flex:1;font-size:14.5px;font-weight:700;line-height:1.5}
  .nx-list .r{flex:none;font-size:12px;color:#64748b}
  .nx-list a:hover .t{color:#ea580c}
  .nx-more{display:inline-block;margin-top:12px;font-weight:800;font-size:13.5px;color:#ea580c;text-decoration:none}
  .nx-rank{background:#fff7ed;border:1px solid #fed7aa;border-radius:14px;padding:16px 16px 12px;align-self:start}
  .nx-rank ol{list-style:none;margin:0;padding:0}
  .nx-rank li{margin:0 0 10px}
  .nx-rank a{display:flex;gap:10px;text-decoration:none;color:var(--navy)}
  .nx-rank .no{flex:none;width:26px;height:26px;border-radius:6px;background:#ea580c;color:#fff;font-weight:800;display:grid;place-items:center;font-size:13px}
  .nx-rank li:nth-child(n+4) .no{background:#94a3b8}
  .nx-rank .t{display:block;font-size:13.5px;font-weight:700;line-height:1.5}
  .nx-rank .m{display:block;font-size:11.5px;color:#9a3412;margin-top:2px}
  .nx-rank a:hover .t{color:#ea580c}
  .nx-note{font-size:11px;color:#94a3b8;margin:6px 0 0}

  .nx-wk{display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:14px}
  .nx-wcard{background:#fff;border:1px solid #fed7aa;border-left:5px solid #ea580c;border-radius:12px;padding:14px 16px}
  .nx-wcard .nx-t{font-size:16px;font-weight:800;line-height:1.45}

  .nx-slist{list-style:none;margin:16px 0 0;padding:0;display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:8px 18px}
  .nx-slist li{margin:0}
  .nx-slist a{display:flex;gap:8px;align-items:baseline;text-decoration:none;color:var(--navy);font-size:14px;font-weight:700;line-height:1.5;padding:6px 0;border-bottom:1px dashed var(--bd)}
  .nx-slist .chip{flex:none}
  .nx-slist a:hover .t{color:var(--acc)}
  .nx-table{margin-top:16px}
  .nx-table .tw{padding:0 12px 12px;overflow-x:auto}

  @media (max-width:760px){
    .nx-grid,.nx-two{grid-template-columns:1fr}
    .nx-subs{grid-template-columns:1fr 1fr;gap:12px}
    .nx-sub .nx-t{font-size:14px}
  }
</style>
