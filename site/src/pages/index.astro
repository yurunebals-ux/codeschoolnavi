---
// トップページ（2026-09-23 ニュースサイト寄りに作り直し）
// オーナー方針: 「まずはアクセス数を増やすサイトを構築する。アフィリエイトは全面に出さない」「トップページもニュースサイトよりに」
// 構成: 日付入りの題字 → トップニュース（大1＋中2）→ 新着ニュース一覧 → 話題のスレ（反応順）→ 週間コラム → 学び・キャリアの読み物 → スクール選びの資料室（折りたたみ比較表つき）
// トップにはアフィリエイト・申込ボタンを置かない。スクールの申込導線は各校記事の末尾だけ。
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import Thumb from "../components/Thumb.astro";
import NavIcon from "../components/NavIcon.astro";
import { catOf } from "../lib/cat";
import { shotsFor } from "../lib/school";
import schools from "../data/schools.json";

const posts = (await getCollection("blog", ({ data }) => !data.draft))
  .sort((a, b) => +new Date(b.data.pubDate) - +new Date(a.data.pubDate) || (b.data.reactions ?? 0) - (a.data.reactions ?? 0));
const chip = (p: any) => catOf(p.data.title, p.data);
const isWeekly = (p: any) => (p.body ?? "").includes("今週の読者への宿題");
const isNew = (d: string) => Date.now() - +new Date(d) < 2 * 86400000;
const md = (d: string) => `${Number(d.slice(5, 7))}/${Number(d.slice(8, 10))}`;
const rx = (n?: number) => (n ? `反応${n.toLocaleString()}` : "");

const news = posts.filter((p) => p.data.news);
const matome = news.filter((p) => !isWeekly(p));
const weekly = news.filter((p) => isWeekly(p)).slice(0, 2);
const [lead, ...restMatome] = matome;
const subs = restMatome.slice(0, 2);
const latestList = restMatome.slice(2, 12);
// 話題のスレ: 直近14日の反応数の多い順
const hot = news
  .filter((p) => (p.data.reactions ?? 0) > 0 && Date.now() - +new Date(p.data.pubDate) < 14 * 86400000)
  .sort((a, b) => (b.data.reactions ?? 0) - (a.data.reactions ?? 0))
  .slice(0, 5);
const reads = posts.filter((p) => p.data.topic).slice(0, 4);
const schoolPosts = posts.filter((p) => !p.data.news && !p.data.topic).slice(0, 6);

// 題字の日付（ビルド時点。日本時間）
const now = new Date(Date.now() + 9 * 3600000);
const wd = ["日", "月", "火", "水", "木", "金", "土"][now.getUTCDay()];
const today = `${now.getUTCFullYear()}年${now.getUTCMonth() + 1}月${now.getUTCDate()}日（${wd}）`;
const todayCount = news.filter((p) => isNew(p.data.pubDate)).length;
const stamp = `${now.getUTCFullYear()}.${String(now.getUTCMonth() + 1).padStart(2, "0")}.${String(now.getUTCDate()).padStart(2, "0")} ${["SUN", "MON", "TUE", "WED", "THU", "FRI", "SAT"][now.getUTCDay()]}`;
const weekRx = news.filter((p) => Date.now() - +new Date(p.data.pubDate) < 7 * 86400000).reduce((n, p) => n + (p.data.reactions ?? 0), 0);
const pad2 = (n: number) => String(n).padStart(2, "0");
---
<Base home={true} title="AIと学びのニュースまとめ・スクール比較" description="AI・プログラミング・働き方のニュースを、ネットの反応と編集部3人の見方つきで毎日まとめ。プログラミングスクールの評判・料金・給付金の比較も。">
  <section class="masthead" slot="hero">
    <div class="mh-bg" aria-hidden="true"></div>
    <div class="wrap">
      <p class="mh-prompt" aria-hidden="true"><span class="u">csn@newsdesk</span>:<span class="d">~</span>$ <b>today --ai --reactions</b><i class="cur"></i></p>
      <p class="mh-date"><span>[ {stamp} ]</span><span class="live"><i></i>LIVE</span>{todayCount > 0 && <b>新着 {todayCount}本</b>}</p>
      <h1 class="mh-title">AIと学びのニュースを、<br /><span class="hl">ネットの反応つきで。</span></h1>
      <p class="mh-lead">国内外のAI・プログラミング・働き方のニュースを毎日まとめています。スレの流れと、編集部3人の「で、学ぶ人はどうする？」を添えて。</p>
      <dl class="mh-hud">
        <div><dt>NEWS</dt><dd>{news.length}<small>本</small></dd></div>
        <div><dt>REACTIONS/7D</dt><dd>{weekRx.toLocaleString()}<small>件</small></dd></div>
      </dl>
      {lead && (
        <ul class="mh-ticker">
          {[lead, ...restMatome.slice(0, 3)].map((p) => (
            <li><a href={`/blog/${p.slug}/`}><em>{md(p.data.pubDate)}</em>{p.data.title}</a></li>
          ))}
        </ul>
      )}
    </div>
    {lead && (
      <nav class="mh-marquee" aria-label="最新ニュースの見出し"><div class="mq">
        {/* ループ用に2周分並べる。2周目は読み上げ・Tab移動の対象から外す */}
        {[0, 1].map((k) => matome.slice(0, 8).map((p) => (
          <a href={`/blog/${p.slug}/`} aria-hidden={k === 1 ? "true" : undefined} tabindex={k === 1 ? -1 : undefined}>▸ {p.data.title}{p.data.reactions ? ` [${p.data.reactions}]` : ""}</a>
        )))}
      </div></nav>
    )}
  </section>

  {lead && (
    <section class="sec nx-top" id="news" style="--sec-c:#0891b2">
      <div class="sec-head"><h2>トップニュース</h2><span class="en">TOP STORIES</span><a class="note" href="/news/">ニュース一覧（{news.length}本）→</a></div>
      <div class="nx-grid">
        <a class="nx-lead" href={`/blog/${lead.slug}/`}>
          <span class="nx-thumb"><Thumb title={lead.data.title} cat="ニュース" shots={[]} eager={true} /></span>
          <span class="nx-meta">{isNew(lead.data.pubDate) && <b class="nx-new">NEW</b>}<span>{lead.data.pubDate}</span>{rx(lead.data.reactions) && <span class="nx-rx">💬 {rx(lead.data.reactions)}</span>}</span>
          <span class="nx-t">{lead.data.title}</span>
          <span class="nx-d">{lead.data.description}</span>
        </a>
        <div class="nx-subs">
          {subs.map((p) => (
            <a class="nx-sub" href={`/blog/${p.slug}/`}>
              <span class="nx-thumb"><Thumb title={p.data.title} cat="ニュース" shots={[]} /></span>
              <span class="nx-meta">{isNew(p.data.pubDate) && <b class="nx-new">NEW</b>}<span>{p.data.pubDate}</span>{rx(p.data.reactions) && <span class="nx-rx">💬 {rx(p.data.reactions)}</span>}</span>
              <span class="nx-t">{p.data.title}</span>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="sec nx-two" style="--sec-c:#0891b2">
    <div class="nx-col">
      <div class="sec-head"><h2>新着ニュース</h2><span class="en">LATEST</span></div>
      <ul class="nx-list">
        {latestList.map((p) => (
          <li><a href={`/blog/${p.slug}/`}>
            <time>{md(p.data.pubDate)}</time>
            <span class="t">{p.data.title}{isNew(p.data.pubDate) && <b class="nx-new">NEW</b>}</span>
            {rx(p.data.reactions) && <span class="r">💬 {p.data.reactions}</span>}
          </a></li>
        ))}
      </ul>
      <a class="nx-more" href="/news/">ニュースをもっと見る →</a>
    </div>
    <aside class="nx-col nx-rank">
      <div class="sec-head"><h2>話題のスレ</h2><span class="en">RANKING</span></div>
      <ol>
        {hot.map((p, i) => (
          <li><a href={`/blog/${p.slug}/`}>
            <span class="no">{pad2(i + 1)}</span>
            <span class="tx"><span class="t">{p.data.title}</span><span class="m">💬 反応{(p.data.reactions ?? 0).toLocaleString()}件 ・ {md(p.data.pubDate)}</span></span>
          </a></li>
        ))}
      </ol>
      <p class="nx-note">反応数は、元記事についた はてなブックマーク等の件数です。</p>
    </aside>
  </section>

  {weekly.length > 0 && (
    <section class="sec band-warm nx-weekly" style="--sec-c:#c026d3">
      <div class="sec-head"><h2>週間コラム</h2><span class="en">WEEKLY</span><span class="note">1週間のニュースを3本束ねて、学ぶ人への宿題つきで</span></div>
      <div class="nx-wk">
        {weekly.map((p) => (
          <a class="nx-wcard" href={`/blog/${p.slug}/`}>
            <span class="nx-meta"><span>{p.data.pubDate}</span></span>
            <span class="nx-t">{p.data.title}</span>
            <span class="nx-d">{p.data.description}</span>
          </a>
        ))}
      </div>
    </section>
  )}

  {reads.length > 0 && (
    <section class="sec nx-reads" style="--sec-c:#65a30d">
      <div class="sec-head"><h2>学び・キャリアの読み物</h2><span class="en">FEATURES</span></div>
      <ul class="cards">
        {reads.map((p) => (
          <li><a class="card row" data-cat={chip(p)} href={`/blog/${p.slug}/`}>
            <span class="cthumb"><Thumb title={p.data.title} cat={chip(p)} shots={[]} compact /></span>
            <span class="cbody"><span class="chip">{chip(p)}</span><span class="t">{p.data.title}</span><span class="d">{p.data.pubDate}</span></span>
          </a></li>
        ))}
      </ul>
    </section>
  )}

  <section class="sec band-blue nx-school" style="--sec-c:#7c3aed">
    <div class="sec-head"><h2>スクール選びの資料室</h2><span class="en">SCHOOL GUIDE</span><span class="note">評判・料金・給付金を公式情報から整理</span></div>
    <div class="nav4">
      <a class="navcard" href="/shindan/"><NavIcon kind="shindan" /><b>6問で診断</b><small>合う3校と注意点を出す</small></a>
      <a class="navcard" href="/kyufukin/"><NavIcon kind="kyufu" /><b>給付金で安く</b><small>区分別の還元率と対象校</small></a>
      <a class="navcard" href="/blog/hyoban-dmmwebcamp/"><NavIcon kind="tenshoku" /><b>転職を目指す</b><small>転職支援つきスクールの実力</small></a>
      <a class="navcard" href="/blog/hyoban-techacademy/"><NavIcon kind="online" /><b>オンライン完結</b><small>働きながら自宅で学ぶ</small></a>
    </div>
    <ul class="nx-slist">
      {schoolPosts.map((p) => (
        <li><a href={`/blog/${p.slug}/`}><span class="chip">{chip(p)}</span><span class="t">{p.data.title}</span></a></li>
      ))}
    </ul>
    <details class="nx-table">
      <summary>掲載{schools.table.length}校の料金・期間をざっくり比較する</summary>
      <div class="tw">
        <table>
          <thead><tr><th>スクール</th><th>形式</th><th>期間</th><th>料金（税込）</th><th>詳細</th></tr></thead>
          <tbody>
            {schools.table.map((s) => (
              <tr><td class="tname"><b>{s.name}</b></td><td>{s.form}</td><td>{s.period}</td><td>{s.price}</td><td><a href={s.review}>評判を見る</a></td></tr>
            ))}
          </tbody>
        </table>
        <p class="tnote">※料金・内容は各記事の更新日時点の公式情報に基づきます。最新条件は必ず公式サイトでご確認ください。</p>
      </div>
    </details>
    <a class="nx-more" href="/blog/">スクールの記事をすべて見る →</a>
  </section>

  <section class="sec policy" style="--sec-c:#64748b">
    <div class="sec-head"><h2>編集方針</h2><span class="en">EDITORIAL POLICY</span></div>
    <p>ニュースは出典を必ず明記し、「スレの流れ」には元記事についた実際のコメントだけを載せます（中傷や容姿への言及は除外）。「編集部の井戸端会議」は編集部スタッフによる会話形式のまとめで、実在の受講者の発言ではありません。スクールの記事は<b>公式サイト・料金表・給付金の指定講座情報</b>をもとに、良い点だけでなく<b>注意点・向かない人</b>も書きます。誤りを見つけた場合は<a href="/about/">運営者情報</a>からご連絡ください。</p>
  </section>
</Base>

<style is:global>
  /* ===== サイバー調テーマ・白ベース（トップだけ）=====
     オーナー「もっとサイバーな感じのトップページで」→「白はベースで」（2026-09-23）
     地は白のまま、方眼・ネオンの細線・角のブラケット・等幅フォント・グラデーション文字でサイバー感を出す */
  /* 色トークン・方眼・ヘッダー・見出しラベルは Base.astro の統一テーマへ移した */

  /* 見出し: 等幅の英字ラベルとネオンのバー */
  .home .sec-head h2::before{background:var(--sec-c,var(--neon));box-shadow:0 0 10px color-mix(in srgb,var(--sec-c,var(--neon)) 60%,transparent);width:4px;border-radius:1px}
  .home .sec-head .en{font-family:var(--mono);color:var(--sec-c,var(--neon-ink));opacity:1;letter-spacing:.12em;font-size:11px}
  .home .sec-head .en::before{content:"// "}
  .home .sec-head .note{font-family:var(--mono);font-size:11.5px}
  .home .sec-head a.note{color:var(--neon-ink);text-decoration:none}
  .home .sec.band-blue{--band:linear-gradient(180deg,#f5feff,#fafcff)}
  .home .sec.band-warm{--band:linear-gradient(180deg,#fdf6ff,#fffaff)}
  .home .sec.band-blue::before,.home .sec.band-warm::before{border-top:1px solid rgba(6,182,212,.18);border-bottom:1px solid rgba(6,182,212,.18)}

  /* ===== 題字（白地のターミナル風） ===== */
  .masthead{position:relative;overflow:hidden;background:#fff;color:var(--fg);padding:26px 0 0;border-bottom:1px solid rgba(6,182,212,.4)}
  .masthead .mh-bg{position:absolute;inset:0;z-index:0;pointer-events:none;
    background:
      linear-gradient(rgba(6,182,212,.10) 1px,transparent 1px) 0 0/100% 32px,
      linear-gradient(90deg,rgba(6,182,212,.10) 1px,transparent 1px) 0 0/32px 100%,
      radial-gradient(640px 300px at 88% -10%,rgba(217,70,239,.14),transparent 70%),
      radial-gradient(560px 280px at -5% 110%,rgba(6,182,212,.16),transparent 70%);
    mask-image:linear-gradient(90deg,#000 0%,#000 55%,transparent 100%)}
  .masthead::after{content:"";position:absolute;left:0;right:0;bottom:0;height:2px;background:linear-gradient(90deg,var(--neon),#8b5cf6,var(--neon2));box-shadow:0 0 12px rgba(139,92,246,.5)}
  .masthead .wrap{position:relative;z-index:1}
  .mh-prompt{display:inline-block;font-family:var(--mono);font-size:12.5px;color:#64748b;margin:0 0 10px;background:#0b1220;color:#94a3b8;padding:4px 10px;border-radius:4px}
  .mh-prompt .u{color:#a3e635}
  .mh-prompt .d{color:#22d3ee}
  .mh-prompt b{color:#f1f5f9;font-weight:600}
  .mh-prompt .cur{display:inline-block;width:7px;height:14px;background:#22d3ee;margin-left:4px;vertical-align:-2px;animation:csnBlink 1s steps(1) infinite}
  @keyframes csnBlink{50%{opacity:0}}
  .masthead .mh-date{display:flex;gap:10px;align-items:center;flex-wrap:wrap;font-family:var(--mono);font-size:12px;color:#64748b;margin:0 0 10px;letter-spacing:.06em}
  .masthead .mh-date .live{display:inline-flex;align-items:center;gap:6px;color:#e11d48;font-weight:700}
  .masthead .mh-date .live i{width:8px;height:8px;border-radius:50%;background:#f43f5e;box-shadow:0 0 8px #f43f5e;animation:csnPulse 1.6s ease-in-out infinite}
  @keyframes csnPulse{50%{opacity:.35}}
  .masthead .mh-date b{border:1px solid var(--neon2);color:var(--neon2-ink);border-radius:3px;padding:1px 8px;font-size:11px;background:#fdf4ff}
  .masthead .mh-title{color:var(--navy);font-size:clamp(24px,5vw,38px);line-height:1.3;margin:0 0 10px;letter-spacing:.01em}
  .masthead .mh-title .hl{background:linear-gradient(90deg,#0891b2,#7c3aed 55%,#c026d3);-webkit-background-clip:text;background-clip:text;color:transparent}
  .masthead .mh-lead{color:#475569;font-size:14px;margin:0 0 16px;max-width:680px}
  .mh-hud{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px;max-width:380px;margin:0 0 16px}
  .mh-hud div{position:relative;border:1px solid rgba(6,182,212,.45);background:rgba(255,255,255,.85);padding:8px 12px;clip-path:polygon(0 0,calc(100% - 10px) 0,100% 10px,100% 100%,10px 100%,0 calc(100% - 10px))}
  .mh-hud div::before{content:"";position:absolute;left:0;top:0;width:3px;height:100%;background:linear-gradient(var(--neon),var(--neon2))}
  .mh-hud dt{font-family:var(--mono);font-size:10px;letter-spacing:.14em;color:var(--neon-ink)}
  .mh-hud dd{margin:2px 0 0;font-family:var(--mono);font-size:20px;font-weight:700;color:var(--navy);font-variant-numeric:tabular-nums}
  .mh-hud small{font-size:11px;color:#64748b;font-weight:400}
  .masthead .mh-ticker{list-style:none;margin:0;padding:10px 0 14px;border-top:1px dashed rgba(6,182,212,.45);display:grid;gap:6px}
  .masthead .mh-ticker li{margin:0}
  .masthead .mh-ticker a{color:var(--navy);text-decoration:none;font-size:13.5px;display:flex;gap:10px;line-height:1.5}
  .masthead .mh-ticker a:hover{color:var(--neon-ink)}
  .masthead .mh-ticker em{font-style:normal;font-family:var(--mono);color:var(--neon2-ink);font-weight:700;flex:none;min-width:40px}
  .mh-marquee{position:relative;z-index:1;border-top:1px solid rgba(6,182,212,.35);background:linear-gradient(90deg,#ecfeff,#faf5ff);overflow:hidden;white-space:nowrap;font-family:var(--mono);font-size:12px;color:var(--neon-ink);padding:7px 0}
  .mh-marquee .mq{display:inline-block;animation:csnMarquee 60s linear infinite}
  .mh-marquee a{margin-right:36px;color:var(--neon-ink);text-decoration:none}
  .mh-marquee a:hover,.mh-marquee a:focus-visible{color:var(--neon2-ink);text-decoration:underline}
  /* 読みたい見出しで止められるよう、マウスを乗せる・タップ・Tab移動で流れを止める */
  .mh-marquee:hover .mq,.mh-marquee:focus-within .mq,.mh-marquee:active .mq{animation-play-state:paused}
  @keyframes csnMarquee{to{transform:translateX(-50%)}}
  @media (max-width:560px){.masthead .mh-ticker li:nth-child(n+3){display:none}.mh-hud dd{font-size:16px}.mh-hud div{padding:7px 9px}}

  /* ===== カード: 白地に細い枠と、角のネオン・ブラケット ===== */
  .nx-meta{display:flex;gap:8px;align-items:center;font-size:11.5px;color:#64748b;flex-wrap:wrap;font-family:var(--mono)}
  .nx-new{border:1px solid #f43f5e;color:#e11d48;background:#fff1f2;font-size:10px;font-weight:800;border-radius:2px;padding:0 5px;margin-left:6px;font-family:var(--mono);letter-spacing:.08em}
  .nx-meta .nx-new{margin-left:0}
  .nx-rx{color:var(--neon2-ink);font-weight:700}
  .nx-grid{display:grid;grid-template-columns:1.6fr 1fr;gap:18px}
  .nx-lead,.nx-sub,.nx-wcard{position:relative;display:flex;flex-direction:column;gap:8px;text-decoration:none;color:var(--navy);background:#fff;border:1px solid #dbe7ef;padding:10px 10px 14px;transition:border-color .2s,box-shadow .2s,transform .2s}
  .nx-lead::before,.nx-sub::before,.nx-wcard::before{content:"";position:absolute;top:-1px;left:-1px;width:14px;height:14px;border-top:2px solid var(--neon);border-left:2px solid var(--neon)}
  .nx-lead::after,.nx-sub::after,.nx-wcard::after{content:"";position:absolute;bottom:-1px;right:-1px;width:14px;height:14px;border-bottom:2px solid var(--neon2);border-right:2px solid var(--neon2)}
  .nx-lead:hover,.nx-sub:hover,.nx-wcard:hover{border-color:rgba(6,182,212,.6);box-shadow:0 0 0 3px rgba(6,182,212,.08),0 10px 24px rgba(14,116,144,.10);transform:translateY(-2px)}
  .nx-thumb{display:block;overflow:hidden;line-height:0}
  .nx-lead .nx-t{font-size:clamp(19px,3.2vw,24px);font-weight:800;line-height:1.4;padding:0 4px}
  .nx-lead .nx-meta,.nx-sub .nx-meta,.nx-lead .nx-d{padding:0 4px}
  .nx-lead .nx-d,.nx-wcard .nx-d{font-size:13.5px;color:#475569;line-height:1.7}
  .nx-subs{display:grid;gap:16px;align-content:start}
  .nx-sub .nx-t{font-size:15px;font-weight:800;line-height:1.45;padding:0 4px}
  .nx-lead:hover .nx-t,.nx-sub:hover .nx-t,.nx-wcard:hover .nx-t{color:var(--neon-ink)}

  .nx-two{display:grid;grid-template-columns:1.5fr 1fr;gap:28px}
  .nx-list{list-style:none;margin:0;padding:0;border-top:1px solid #dbe7ef}
  .nx-list li{margin:0;border-bottom:1px solid #e6eef4}
  .nx-list a{display:flex;gap:12px;align-items:baseline;padding:11px 4px;text-decoration:none;color:var(--navy);transition:background .15s}
