---
const { title, description, article } = Astro.props;
const site = import.meta.env.SITE_TITLE || "コードスクールナビ";
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} | {site}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={article ? "article" : "website"} />
    {article && (
      <script type="application/ld+json" set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "Article",
        headline: article.title,
        author: { "@type": "Person", name: article.author },
        datePublished: article.pubDate,
        dateModified: article.updatedDate || article.pubDate,
      })} />
    )}
    <style is:global>
      :root{
        --fg:#1e293b;--mut:#64748b;--bd:#e2e8f0;
        --acc:#2563eb;--acc-dark:#1e40af;--navy:#0f2744;
        --cta:#f97316;--bg:#f6f8fb;--card:#ffffff;
        --chip:#eff6ff;--chip-fg:#1d4ed8;--notice:#fffbeb;--notice-bd:#fde68a;
      }
      *{box-sizing:border-box}
      html{scroll-behavior:smooth}
      body{margin:0;font-family:-apple-system,BlinkMacSystemFont,"Hiragino Sans","Noto Sans JP","Segoe UI",Roboto,sans-serif;color:var(--fg);line-height:1.75;background:var(--bg);font-size:16px}
      .wrap{max-width:820px;margin:0 auto;padding:0 20px}

      /* Header */
      header.site{position:sticky;top:0;z-index:50;background:rgba(255,255,255,.92);backdrop-filter:blur(8px);border-bottom:1px solid var(--bd)}
      .nav{display:flex;align-items:center;gap:8px;height:60px}
      .brand{display:flex;align-items:center;gap:9px;text-decoration:none;color:var(--navy);font-weight:800;font-size:17px;letter-spacing:.02em;margin-right:auto}
      .logo{width:30px;height:30px;border-radius:8px;background:linear-gradient(135deg,#2563eb,#7c3aed);color:#fff;display:flex;align-items:center;justify-content:center;font-size:14px;font-weight:800;font-family:ui-monospace,monospace}
      .nav a.item{color:#334155;text-decoration:none;font-size:13.5px;font-weight:600;padding:7px 10px;border-radius:8px;white-space:nowrap}
      .nav a.item:hover{background:#f1f5f9;color:var(--acc-dark)}
      .nav a.cta{background:var(--cta);color:#fff;font-size:13.5px;font-weight:700;text-decoration:none;padding:8px 14px;border-radius:999px;white-space:nowrap;box-shadow:0 2px 8px rgba(249,115,22,.35)}
      .nav a.cta:hover{filter:brightness(1.06)}
      @media (max-width:640px){ .nav a.item{display:none} .nav a.item.keep{display:block} }

      /* Main */
      main.wrap{padding-top:36px;padding-bottom:64px}
      h1{font-size:clamp(24px,4.5vw,32px);line-height:1.35;letter-spacing:.01em;color:var(--navy);margin:0 0 14px;font-weight:800}
      main :is(h2){font-size:21px;color:var(--navy);margin:44px 0 14px;padding:6px 0 8px 14px;border-left:5px solid var(--acc);border-bottom:2px solid var(--bd);font-weight:800;line-height:1.4}
      main :is(h3){font-size:17.5px;color:var(--navy);margin:30px 0 10px;font-weight:700}
      main a{color:var(--acc);text-decoration-thickness:1px;text-underline-offset:3px}
      main a:hover{color:var(--acc-dark)}
      p{margin:0 0 1.1em}
      ul,ol{padding-left:1.4em}
      li{margin:.3em 0}

      /* Tables */
      table{width:100%;border-collapse:collapse;margin:18px 0;font-size:14px;background:var(--card);border-radius:10px;overflow:hidden;box-shadow:0 1px 3px rgba(15,39,68,.08);display:block;overflow-x:auto;white-space:nowrap}
      thead th{background:var(--navy);color:#fff;font-weight:700;padding:11px 14px;text-align:left}
      td{border-bottom:1px solid var(--bd);padding:11px 14px}
      tbody tr:nth-child(even){background:#f8fafc}
      tbody tr:last-child td{border-bottom:0}

      /* 蛍光マーカー強調（業界の定番・可読性と行動喚起） */
      main article strong{background:linear-gradient(transparent 60%, #fde047 60%);padding:0 1px}

      /* 外部（アフィリエイト/公式）リンク → オレンジCTAボタン化。
         rehype-external-links が rel="sponsored" を自動付与するのを利用 */
      main article a[rel~="sponsored"]{display:inline-block;background:var(--cta);color:#fff !important;font-weight:800;text-decoration:none;padding:10px 20px;border-radius:999px;font-size:14.5px;margin:4px 2px;box-shadow:0 3px 10px rgba(249,115,22,.35);line-height:1.4}
      main article a[rel~="sponsored"]::after{content:" ↗";font-size:12px}
      main article a[rel~="sponsored"]:hover{filter:brightness(1.07);color:#fff}

      /* 目次ボックス */
      .toc{background:var(--card);border:1px solid var(--bd);border-radius:12px;padding:16px 20px;margin:20px 0 26px;box-shadow:0 1px 3px rgba(15,39,68,.06)}
      .toc .toc-title{font-weight:800;color:var(--navy);font-size:14px;display:flex;align-items:center;gap:7px;margin-bottom:8px}
      .toc ol{margin:0;padding-left:1.3em;font-size:14px}
      .toc a{color:#334155;text-decoration:none}
      .toc a:hover{color:var(--acc);text-decoration:underline}

      /* Notice (ad disclosure blockquote) */
      blockquote{background:var(--notice);border:1px solid var(--notice-bd);border-radius:10px;margin:14px 0 22px;padding:12px 16px;color:#78716c;font-size:13px;line-height:1.7}
      blockquote p{margin:0}

      /* Article meta */
      .meta{color:var(--mut);font-size:13px;margin-bottom:18px;display:flex;gap:12px;flex-wrap:wrap;align-items:center}
      .meta .badge{background:var(--chip);color:var(--chip-fg);border-radius:999px;padding:3px 11px;font-weight:700;font-size:12px}
      .eyecatch{border-radius:14px;overflow:hidden;margin:0 0 24px;box-shadow:0 2px 10px rgba(15,39,68,.12)}
      .eyecatch svg{width:100%;height:auto;display:block}

      /* Hero (homepage) */
      .hero{background:linear-gradient(160deg,#0f2744 0%,#1e3a8a 60%,#2563eb 100%);color:#fff;padding:44px 0 40px;margin:0}
      .hero .kicker{color:#93c5fd;font-size:13.5px;font-weight:700;letter-spacing:.06em;margin-bottom:10px}
      .hero h1{color:#fff;font-size:clamp(26px,5vw,38px);margin-bottom:14px}
      .hero p{color:#dbeafe;font-size:15.5px;max-width:640px;margin-bottom:22px}
      .hero .actions{display:flex;gap:12px;flex-wrap:wrap}
      .hero a.primary{background:var(--cta);color:#fff;font-weight:800;text-decoration:none;padding:12px 22px;border-radius:999px;font-size:15px;box-shadow:0 4px 14px rgba(249,115,22,.45)}
      .hero a.primary:hover{filter:brightness(1.07)}
      .hero a.ghost{border:1.5px solid rgba(255,255,255,.55);color:#fff;font-weight:700;text-decoration:none;padding:12px 22px;border-radius:999px;font-size:15px}
      .hero a.ghost:hover{background:rgba(255,255,255,.12)}
      .hero .points{display:flex;gap:18px;flex-wrap:wrap;margin-top:26px;padding:0;list-style:none}
      .hero .points li{font-size:13px;color:#bfdbfe;display:flex;align-items:center;gap:6px;margin:0}
      .hero .points li::before{content:"✓";color:#4ade80;font-weight:800}


      /* Footer */
      footer.site{background:var(--navy);color:#cbd5e1;margin-top:20px}
      footer.site .inner{padding:34px 0 30px;font-size:13px;line-height:1.8}
      footer.site .fbrand{color:#fff;font-weight:800;font-size:15px;margin-bottom:8px;display:flex;align-items:center;gap:8px}
      footer.site a{color:#93c5fd;text-decoration:none}
      footer.site a:hover{text-decoration:underline}
      footer.site .links{display:flex;gap:18px;flex-wrap:wrap;margin:12px 0}
      footer.site .copy{color:#64748b;font-size:12px;margin-top:14px}

      /* ==== ホームの意思決定モジュール（競合トップページ分析に基づく） ==== */
      .sec{margin-top:46px}
      .sec-head{display:flex;align-items:baseline;gap:10px;flex-wrap:wrap;margin-bottom:16px;border-bottom:2px solid var(--navy);padding-bottom:8px}
      .sec-head h2{border:0;margin:0;padding:0;font-size:20px}
      .sec-head .en{color:#94a3b8;font-size:11px;font-weight:800;letter-spacing:.18em}
      .sec-head .note{color:var(--mut);font-size:12px;margin-left:auto}

      /* 目的別ナビ */
      .nav4{display:grid;grid-template-columns:repeat(4,1fr);gap:12px}
      @media (max-width:720px){ .nav4{grid-template-columns:repeat(2,1fr)} }
      .navcard{display:flex;flex-direction:column;gap:4px;background:var(--card);border:1px solid var(--bd);border-radius:13px;padding:15px 15px 13px;text-decoration:none;color:var(--fg);box-shadow:0 1px 3px rgba(15,39,68,.06);transition:box-shadow .15s,transform .15s}
      .navcard:hover{box-shadow:0 6px 16px rgba(15,39,68,.13);transform:translateY(-2px)}
      .navcard .ic{font-size:21px}
      .navcard b{color:var(--navy);font-size:14.5px}
      .navcard small{color:var(--mut);font-size:11.5px;line-height:1.5}

      /* 編集部ピックアップ */
      .picks{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}
      @media (max-width:820px){ .picks{grid-template-columns:1fr} }
      .pick{background:var(--card);border:1px solid var(--bd);border-radius:14px;padding:0 18px 18px;box-shadow:0 1px 3px rgba(15,39,68,.07);display:flex;flex-direction:column}
      .pick .ribbon{align-self:flex-start;background:var(--navy);color:#fff;font-size:12px;font-weight:800;border-radius:0 0 8px 8px;padding:6px 12px;letter-spacing:.03em}
      .pick h3{margin:12px 0 8px;font-size:18px;color:var(--navy);display:flex;flex-direction:column;gap:2px}
      .pick h3 small{color:var(--mut);font-size:12px;font-weight:600}
      .pick .specs{margin:0 0 10px;display:grid;gap:4px}
      .pick .specs div{display:flex;gap:8px;font-size:13.5px;border-bottom:1px dashed var(--bd);padding:4px 0}
      .pick .specs dt{color:var(--mut);min-width:3em}
      .pick .specs dd{margin:0}
      .pick .specs b{color:#c2410c}
      .pick .tags{list-style:none;display:flex;flex-wrap:wrap;gap:6px;padding:0;margin:0 0 10px}
      .pick .tags li{background:var(--chip);color:var(--chip-fg);font-size:11.5px;font-weight:700;border-radius:999px;padding:3px 10px;margin:0}
      .pick .fit{font-size:13px;color:#166534;background:#f0fdf4;border:1px solid #bbf7d0;border-radius:8px;padding:8px 10px;margin:0 0 12px}
      .pick .more{margin-top:auto;text-align:center;background:var(--cta);color:#fff;font-weight:800;text-decoration:none;border-radius:999px;padding:10px 14px;font-size:13.5px;box-shadow:0 3px 10px rgba(249,115,22,.32)}
      .pick .more:hover{filter:brightness(1.06);color:#fff}
      .tnote{color:var(--mut);font-size:12px;margin-top:8px}

      /* サムネイル付き記事カード */
      .cards{list-style:none;padding:0;margin:0;display:grid;grid-template-columns:1fr 1fr;gap:14px}
      @media (max-width:720px){ .cards{grid-template-columns:1fr} }
      .card{display:flex;flex-direction:column;background:var(--card);border:1px solid var(--bd);border-radius:14px;overflow:hidden;text-decoration:none;color:var(--fg);box-shadow:0 1px 3px rgba(15,39,68,.06);transition:box-shadow .15s,transform .15s,border-color .15s}
      .card:hover{box-shadow:0 6px 18px rgba(15,39,68,.12);transform:translateY(-2px);border-color:#bfdbfe}
      .cthumb{display:block;aspect-ratio:16/9;overflow:hidden}
      .cthumb svg{width:100%;height:100%;display:block}
      .cbody{display:flex;flex-direction:column;gap:6px;padding:14px 16px 15px}
      .card .chip{align-self:flex-start;display:inline-block;background:var(--chip);color:var(--chip-fg);border-radius:999px;padding:2px 11px;font-size:12px;font-weight:700}
      .card .t{display:block;font-size:15.5px;font-weight:700;color:var(--navy);line-height:1.5}
      .card:hover .t{color:var(--acc)}
      .card .d{color:var(--mut);font-size:12.5px}

      /* 選び方ステップ */
      .steps{list-style:none;counter-reset:st;padding:0;margin:0;display:grid;gap:10px}
      .steps li{counter-increment:st;background:var(--card);border:1px solid var(--bd);border-radius:12px;padding:14px 16px 14px 58px;position:relative;margin:0}
      .steps li::before{content:counter(st);position:absolute;left:16px;top:14px;width:30px;height:30px;border-radius:999px;background:var(--navy);color:#fff;font-weight:800;display:flex;align-items:center;justify-content:center;font-size:15px}
      .steps b{display:block;color:var(--navy);font-size:15px;margin-bottom:2px}
      .steps span{color:var(--mut);font-size:13.5px;line-height:1.7}

      /* FAQ */
      details{background:var(--card);border:1px solid var(--bd);border-radius:12px;padding:0;margin:0 0 10px;overflow:hidden}
      summary{cursor:pointer;font-weight:700;color:var(--navy);font-size:14.5px;padding:14px 16px;list-style:none;position:relative;padding-right:40px}
      summary::-webkit-details-marker{display:none}
      summary::after{content:"＋";position:absolute;right:16px;top:12px;color:var(--acc);font-weight:800}
      details[open] summary::after{content:"−"}
      details p{padding:0 16px 14px;margin:0;font-size:13.5px;color:#334155}

      /* 編集方針 */
      .policy p{background:var(--card);border:1px solid var(--bd);border-left:5px solid var(--navy);border-radius:10px;padding:16px 18px;font-size:13.5px;line-height:1.9;color:#334155}

      /* Shindan buttons reuse */
      .opt{text-align:left;padding:15px 18px;border:1px solid var(--bd);border-radius:12px;background:var(--card);color:var(--fg);font-size:15px;cursor:pointer;box-shadow:0 1px 3px rgba(15,39,68,.06)}
      .opt:hover{border-color:var(--acc);box-shadow:0 4px 12px rgba(37,99,235,.15)}
    </style>
  </head>
  <body>
    <header class="site"><div class="wrap nav">
      <a class="brand" href="/"><span class="logo">&lt;/&gt;</span>{site}</a>
      <a class="item" href="/about/">運営者情報</a>
      <a class="item keep" href="/disclosure/">広告について</a>
      <a class="item" href="/privacy/">プライバシー</a>
      <a class="cta" href="/shindan/">30秒診断</a>
    </div></header>
    <slot name="hero" />
    <main class="wrap"><slot /></main>
    <footer class="site"><div class="wrap inner">
      <div class="fbrand"><span class="logo">&lt;/&gt;</span>{site}</div>
      <p>プログラミングスクールを料金・サポート・転職実績で正直に比較する情報サイトです。</p>
      <p>【広告】当サイトはアフィリエイト広告（プロモーション）を利用していますが、評価や順位には影響しません。詳しくは<a href="/disclosure/">広告について</a>をご覧ください。</p>
      <div class="links">
        <a href="/shindan/">スクール診断</a>
        <a href="/about/">運営者情報</a>
        <a href="/disclosure/">広告について</a>
        <a href="/privacy/">プライバシーポリシー</a>
      </div>
      <p class="copy">© {new Date().getFullYear()} {site}</p>
    </div></footer>
  </body>
</html>
