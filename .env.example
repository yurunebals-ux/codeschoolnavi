# ===== LLM provider =====
# LLM_PROVIDER: "openai" | "anthropic" | "openai-compatible"
LLM_PROVIDER=openai
LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxx
# Model used for article generation
LLM_MODEL=gpt-4o-mini
# Only for openai-compatible endpoints (e.g. OpenRouter). Leave blank otherwise.
LLM_BASE_URL=

# ===== Site（日本語サイト）=====
SITE_URL=https://codeschoolnavi.com
SITE_NAME=コードスクールナビ｜プログラミングスクール比較
SITE_AUTHOR=編集部
SITE_NICHE=programming-schools

# ===== Pipeline knobs =====
# 1サイクルあたりの生成本数
ARTICLES_PER_CYCLE=3
# 公開に必要な品質スコア(0-100)
QUALITY_MIN_SCORE=70
# 最低文字数（日本語は文字数で判定）
MIN_WORDS=1200

# ===== IndexNow (instant search-engine notification) =====
# 生成済みキー（この値のまま利用可。publish時に /<KEY>.txt を自動配置します）
INDEXNOW_KEY=a77cf03e731e2c8ffbef06cf3fd92398

# ===== Google Search Console (optional, for analytics:loop) =====
# Path to a service-account JSON key with GSC read access. Leave blank to skip.
GSC_SERVICE_ACCOUNT_JSON=
GSC_SITE_URL=
